---
import SectionHeading from './SectionHeading.astro';
import CategoryCard from './CategoryCard.astro';
import { CATEGORIES, SERVICES } from '@config/site';
interface Step { title: string; desc: string }
interface Props { eyebrow?: string; title: string; titleAccent?: string; desc?: string; body?: string[]; steps: Step[] }
const { eyebrow = 'Cómo trabajamos', title, titleAccent, desc, body = [], steps } = Astro.props;
const routes = [
  { href: '/contacto', label: 'Iniciar solicitud', media: SERVICES[0] },
  { href: '/productos', label: 'Ver catálogo de equipo', media: CATEGORIES[0] },
  { href: '/contacto', label: 'Solicitar asesoría', media: SERVICES[3] },
];
---
<section class="section section--surface">
  <div class="container">
    <SectionHeading layout="duo" eyebrow={eyebrow} title={title} titleAccent={titleAccent} desc={desc} body={body} />
    <ol class="process-grid" aria-label="Pasos para solicitar una cotización">
      {steps.map((step, index) => {
        const route = routes[index] ?? routes[0];
        return <li><CategoryCard label={step.title} blurb={step.desc} href={route.href} ctaLabel={route.label} badge={`Paso ${index + 1}`} image={route.media.image} imageAlt={route.media.imageAlt} /></li>;
      })}
    </ol>
  </div>
</section>
<style>
  .process-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); margin: 0; padding: 0; list-style: none; }
  .process-grid li { min-width: 0; }
  @media (max-width: 767px) { .process-grid { grid-template-columns: 1fr; } }
</style>
