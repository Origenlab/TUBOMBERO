---
interface CTA { text: string; href?: string; variant?: 'primary' | 'outline'; external?: boolean; }
interface Props { badge?: string; title: string; accent?: string; after?: string; subtitle?: string; coverage?: string; descRight?: string[]; ctas?: CTA[]; image?: { src: string; alt: string }; }
const { badge, title, accent, after, subtitle, coverage, descRight = [], ctas = [], image } = Astro.props;
---
<section class="hero"><div class="container hero__inner"><div class="hero__copy">{badge && <span class="hero__badge"><i aria-hidden="true"></i>{badge}</span>}<h1>{title}{accent && <span>{accent}</span>}{after && <> {after}</>}</h1>{subtitle && <p class="hero__subtitle">{subtitle}</p>}{ctas.length > 0 && <div class="hero__ctas">{ctas.filter((cta) => cta.href).map((cta) => <a class:list={['hero__btn', cta.variant === 'outline' ? 'hero__btn--outline' : 'hero__btn--primary']} href={cta.href} target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener noreferrer' : undefined}>{cta.text}<span aria-hidden="true">→</span></a>)}</div>}{coverage && <p class="hero__coverage">{coverage}</p>}</div>{descRight.length > 0 && <div class="hero__right">{descRight.map((text) => <p>{text}</p>)}{image && <figure><img src={image.src} alt={image.alt} width="1200" height="800" fetchpriority="high" /><figcaption>Tu Bombero · Catálogo técnico y soluciones</figcaption></figure>}</div>}</div></section>
<style>
  .hero { position: relative; overflow: hidden; background: var(--c-ink); color: var(--c-white); padding-block: clamp(4.5rem, 10vw, 8rem); }
  .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 78% 35%, rgb(var(--c-primary-rgb) / .34), transparent 42%), linear-gradient(90deg, transparent 95%, rgb(255 255 255 / .04) 95%) 0 0 / 5rem 5rem; pointer-events: none; }
  .hero__inner { position: relative; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .hero__badge { display: inline-flex; align-items: center; gap: var(--sp-2); padding: .45rem .8rem; border: 1px solid rgb(255 255 255 / .2); border-radius: var(--radius-full); color: rgb(255 255 255 / .82); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: .08em; text-transform: uppercase; }
  .hero__badge i { width: .45rem; height: .45rem; border-radius: var(--radius-full); background: var(--c-primary-light); }
  .hero h1 { max-width: 12ch; margin: var(--sp-5) 0; font-family: var(--font-heading); font-size: var(--text-4xl); line-height: var(--leading-tight); letter-spacing: -.04em; }
  .hero h1 span { color: var(--c-primary-light); }
  .hero__subtitle, .hero__right p { color: rgb(255 255 255 / .72); font-size: var(--text-lg); line-height: var(--leading-relaxed); }
  .hero__subtitle { max-width: 52ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }
  .hero__coverage { margin: var(--sp-4) 0 0; color: rgb(255 255 255 / .62); font-size: var(--text-sm); }
  .hero__btn { display: inline-flex; align-items: center; gap: var(--sp-2); min-height: 3rem; padding: 0 1.25rem; border-radius: var(--radius-md); font-weight: var(--weight-bold); text-decoration: none; }
  .hero__btn--primary { background: var(--c-primary); color: var(--c-white); }
  .hero__btn--outline { border: 1px solid rgb(255 255 255 / .38); color: var(--c-white); }
  .hero__right { display: grid; gap: var(--sp-4); }
  .hero__right p { margin: 0; font-size: var(--text-base); }
  .hero figure { position: relative; min-height: 18rem; margin: var(--sp-3) 0 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  .hero figure img { display: block; width: 100%; height: 100%; min-height: 18rem; object-fit: cover; }
  .hero figcaption { position: absolute; right: 0; bottom: 0; left: 0; padding: var(--sp-3); background: linear-gradient(transparent, rgb(20 24 31 / .78)); color: var(--c-white); font-size: var(--text-sm); font-weight: var(--weight-semibold); }
</style>
