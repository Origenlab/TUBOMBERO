---
// Hero.astro — Hero oscuro reutilizable: gradiente + glow radial, badge con punto, H1 con acento de marca, columna derecha y CTAs opcionales. ORIGEN: PROYECTORED/src/components/sections/Hero.astro (estructura 2 columnas + CTAs) fusionado con el fondo canónico de MESECI/HeroBase (gradiente 155deg + radial rojo).
// CTAs OPCIONALES: el patrón canónico MESECI (REGLA HeroBase) recomienda "el hero presenta, NavRapida/QuickLinks convierte". Pásalos sólo en L1/L2 si el negocio lo requiere. waUrl() desde config para el CTA de WhatsApp.
import { Picture } from 'astro:assets';
import Icon from '@components/Icon.astro';
import type { ImageMetadata } from 'astro';

interface HeroCTA {
  text: string
  href: string
  variant?: 'primary' | 'outline'
  whatsapp?: boolean   // true → ícono WA + target _blank
}
interface Props {
  badge?: string
  title: string
  /** Última(s) palabra(s) del título resaltadas con color de marca. */
  accent?: string
  after?: string
  subtitle?: string
  /** Párrafos de la columna derecha (presentación). En móvil se apilan bajo el título. */
  descRight?: string[]
  ctas?: HeroCTA[]
  ariaLabel?: string
  coverage?: string
  image?: { src: ImageMetadata; alt: string }
}
const { badge, title, accent, after, subtitle, descRight = [], ctas = [], ariaLabel = 'Encabezado principal', coverage, image } = Astro.props

---

<section class="hero" aria-label={ariaLabel}>
  <div class="hero__inner">
    <div class="hero__left">
      {badge && <span class="hero__badge"><span class="hero__badge-dot" aria-hidden="true"></span>{badge}</span>}
      <h1 class="hero__title">{title}{accent && <span class="hero__accent">{` ${accent.trim()}`}</span>}{after && ` ${after.trim()}`}</h1>
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}
      {ctas.length > 0 && (
        <div class="hero__ctas">
          {ctas.map((cta) => (
            <a
              href={cta.href}
              class:list={['hero__btn', cta.variant === 'outline' ? 'hero__btn--outline' : 'hero__btn--primary']}
              target={cta.whatsapp || cta.href.startsWith('http') ? '_blank' : undefined}
              rel={cta.whatsapp || cta.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {cta.whatsapp && <Icon name="whatsapp" size={18} />}
              {cta.text}
            </a>
          ))}
        </div>
      )}
      {coverage && <p class="hero__coverage">{coverage}</p>}
    </div>
    {descRight.length > 0 && (
      <div class="hero__right">
        {descRight.map((p) => <p class="hero__desc">{p}</p>)}
        {image && <figure class="hero__figure"><Picture src={image.src} alt={image.alt} width={1200} height={800} widths={[640, 1200]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="avif" loading="eager" fetchpriority="high" decoding="async" /><figcaption>Tu Bombero · Catálogo técnico y soluciones</figcaption></figure>}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(155deg, var(--c-black) 0%, var(--c-ink) 55%, var(--c-ink-3) 100%);
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 75% 40%, color-mix(in srgb, var(--color-red, var(--c-primary)) 22%, transparent) 0%, transparent 60%),
      linear-gradient(transparent 59px, rgba(255,255,255,.025) 60px) 0 0 / 60px 60px,
      linear-gradient(90deg, transparent 59px, rgba(255,255,255,.025) 60px) 0 0 / 60px 60px;
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    max-width: var(--container-max, 1400px);
    margin-inline: auto;
    padding-inline: var(--container-px, 1.5rem);
  }
  .hero__badge {
    display: inline-flex; align-items: center; gap: var(--sp-2, .5rem);
    padding: var(--sp-2, .5rem) var(--sp-4, 1rem);
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: var(--radius-full, 9999px);
    font-size: var(--text-sm, .875rem);
    font-weight: var(--weight-medium, 500);
    color: rgba(255,255,255,.9);
    margin-bottom: var(--sp-5, 1.25rem);
  }
  .hero__badge-dot {
    width: 6px; height: 6px; background: var(--color-red-light, var(--c-primary-light)); border-radius: 50%; flex-shrink: 0;
    animation: hero-pulse 2s ease-in-out infinite;
  }
  @keyframes hero-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
  @media (prefers-reduced-motion: reduce) { .hero__badge-dot { animation: none; } }
  .hero__title {
    font-size: var(--text-4xl, clamp(2.5rem, 4.5vw, 3.75rem));
    font-weight: var(--weight-black, 800);
    line-height: var(--leading-tight, 1.2);
    color: var(--c-white);
    margin-bottom: var(--sp-5, 1.25rem);
    letter-spacing: -.02em;
  }
  .hero__accent { color: var(--color-red-light, var(--c-primary-light)); }
  .hero__subtitle {
    font-size: var(--text-base, 1.0625rem);
    color: rgba(255,255,255,.75);
    line-height: var(--leading-relaxed, 1.7);
    max-width: 52ch;
    margin-bottom: var(--sp-8, 2rem);
  }
  .hero__coverage { margin: var(--sp-4) 0 0; color: rgba(255,255,255,.62); font-size: var(--text-sm); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--sp-3, .75rem); }
  .hero__btn {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .8125rem 1.625rem;
    font-size: var(--text-sm, .9375rem); font-weight: var(--weight-bold, 700);
    border-radius: var(--radius-md, 6px); text-decoration: none;
    transition: all .18s ease;
  }
  .hero__btn--primary { background: var(--color-red, var(--c-primary)); color: var(--c-white); border: 2px solid var(--color-red, var(--c-primary)); }
  .hero__btn--primary:hover { background: var(--color-red-dark, var(--c-primary-dark)); border-color: var(--color-red-dark, var(--c-primary-dark)); }
  .hero__btn--outline { background: transparent; color: rgba(255,255,255,.9); border: 2px solid rgba(255,255,255,.35); }
  .hero__btn--outline:hover { border-color: rgba(255,255,255,.7); background: rgba(255,255,255,.08); color: var(--c-white); }
  .hero__btn:focus-visible { outline: 2px solid var(--c-white); outline-offset: 3px; }
  .hero__right { display: flex; flex-direction: column; justify-content: center; gap: var(--sp-5, 1.25rem); }
  .hero__desc { font-size: var(--text-base, 1.0625rem); color: rgba(255,255,255,.78); line-height: var(--leading-relaxed, 1.7); margin: 0; text-align: justify; text-justify: inter-word; hyphens: auto; -webkit-hyphens: auto; }
  @media (max-width: 640px) { .hero__desc { text-align: left; } }
  @media (max-width: 560px) {
    .hero__ctas { flex-direction: column; }
    .hero__btn { width: 100%; justify-content: center; }
  }
  @media (max-width: 768px) {
    .hero__inner { grid-template-columns: 1fr; gap: clamp(1.5rem, 5vw, 2.25rem); }
    .hero__title { font-size: clamp(1.9rem, 7vw, 2.6rem); }
    .hero__subtitle, .hero__desc { font-size: clamp(1rem, 4vw, 1.0625rem); }
    .hero__right { gap: var(--sp-4, 1rem); }
    .hero__inner { padding-left: max(var(--container-px), env(safe-area-inset-left)); padding-right: max(var(--container-px), env(safe-area-inset-right)); }
  }
  @media (max-width: 480px) {
    .hero__ctas { flex-direction: column; width: 100%; }
    .hero__btn { width: 100%; justify-content: center; min-height: 48px; }
  }
</style>
