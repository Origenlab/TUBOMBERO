---
import { CATEGORIES, publishedDirectoryStatePath, SERVICES } from '@config/site';
import type { DirectoryState } from '@config/site';
import { getGuides } from '@lib/guides';

interface Props {
  states: readonly DirectoryState[];
}

const { states } = Astro.props;

const directoryPhotos = [
  { id: '1600624697183-00566baf12e6', sourceUrl: 'https://unsplash.com/es/fotos/camion-de-bomberos-rojo-y-blanco-estacionado-cerca-del-edificio-durante-el-dia-LM3ISKU4Dk8', alt: 'Camión de bomberos rojo y blanco estacionado junto a un edificio', position: 'center' },
  { id: '1576707995936-a6cffe26ef7b', sourceUrl: 'https://unsplash.com/es/fotos/bomberos-rociando-agua-sobre-el-fuego-newCTAG6kPE', alt: 'Bomberos con equipo de protección usando una manguera durante una intervención', position: 'center' },
  { id: '1660323671848-928629deddca', sourceUrl: 'https://unsplash.com/es/fotos/un-camion-de-bomberos-en-la-calle-egergv8fSG8', alt: 'Camión de bomberos rojo en una calle', position: 'center' },
  { id: '1575867094974-9e16b6f55360', sourceUrl: 'https://unsplash.com/es/fotos/bomberos-cerca-del-incendio-j6oWhh7l4Ig', alt: 'Bomberos con equipo de protección cerca de una zona de incendio', position: 'center' },
  { id: '1610586618549-a05378824c91', sourceUrl: 'https://unsplash.com/es/fotos/camion-de-bomberos-rojo-y-blanco-en-la-carretera-durante-la-noche-FmycYDIbzFs', alt: 'Camión de bomberos rojo y blanco durante una operación nocturna', position: 'center' },
  { id: '1636248552051-d13fe1330f51', sourceUrl: 'https://unsplash.com/es/fotos/un-camion-de-bomberos-conduciendo-por-una-calle-junto-a-edificios-altos-O9A_0qmav50', alt: 'Camión de bomberos circulando entre edificios', position: 'center' },
  { id: '1552244935-439697eea0bd', sourceUrl: 'https://unsplash.com/es/fotos/camion-de-bomberos-rojo-5yGxeS9IWJ8', alt: 'Detalle de un camión de bomberos rojo', position: 'center' },
  { id: '1622783089891-ddf18baab338', sourceUrl: 'https://unsplash.com/es/fotos/un-camion-de-bomberos-rojo-estacionado-al-costado-de-la-carretera-Y2ZJ5XqRB1s', alt: 'Camión de bomberos rojo estacionado al costado de una carretera', position: 'center' },
] as const;

const unsplashUrl = (id: string, width: number) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${width}&q=82`;
const unsplashSrcset = (id: string) => [480, 720, 960, 1400].map((width) => `${unsplashUrl(id, width)} ${width}w`).join(', ');
const guides = await getGuides();
---

<div class="state-directory-layout state-directory-layout--right">
  <div class="state-directory-grid" aria-label="Directorio de estaciones de bomberos por entidad federativa">
    {states.map((state, index) => {
      const photo = directoryPhotos[index % directoryPhotos.length];
      return (
        <article id={`estado-${state.slug}`} class="state-directory-card">
          <div class="state-directory-card__media">
            <img
              src={unsplashUrl(photo.id, 1400)}
              srcset={unsplashSrcset(photo.id)}
              sizes="(min-width: 1180px) 27vw, (min-width: 720px) 50vw, 100vw"
              alt={photo.alt}
              width="1400"
              height="960"
              loading={index < 2 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
              class="state-directory-card__image"
              style={`object-position: ${photo.position}`}
            />
          </div>
          <div class="state-directory-card__body">
            <h3 class="state-directory-card__title">Estaciones de bomberos en {state.label}</h3>
            <p class="state-directory-card__description">
              El directorio de estaciones de bomberos en {state.label} se publicará con registros institucionales verificables. Será un punto de consulta para localizar cuerpos de bomberos y canales de atención de emergencia cuando cada ficha esté confirmada.
            </p>
            <a class="state-directory-card__cta" href={publishedDirectoryStatePath(state.slug) ?? '/contacto'}>Consultar directorio de bomberos en {state.label}</a>
          </div>
        </article>
      );
    })}
  </div>

  <aside class="state-directory-sidebar" aria-label="Explorar el directorio y recursos relacionados">
    <section class="state-directory-sidebar__widget state-directory-sidebar__widget--intro">
      <p class="state-directory-sidebar__eyebrow">Directorio nacional</p>
      <h3>Consulta estaciones de bomberos por entidad</h3>
      <p>Ubica una entidad y continúa explorando equipo, servicios y guías de protección contra incendios.</p>
    </section>

    <section class="state-directory-sidebar__widget state-directory-sidebar__widget--states">
      <p class="state-directory-sidebar__eyebrow">Navega por estado</p>
      <nav aria-label="Estados del directorio">
        <ul class="state-directory-sidebar__states">
          {states.map((state) => (
            <li><a href={`/directorio#estado-${state.slug}`}>Bomberos en {state.label}</a></li>
          ))}
        </ul>
      </nav>
    </section>

    <section class="state-directory-sidebar__widget state-directory-sidebar__widget--categories">
      <p class="state-directory-sidebar__eyebrow">Equipo contra incendio</p>
      <h3>Soluciones para brigadas y empresas</h3>
      <ul class="state-directory-sidebar__link-list">
        {CATEGORIES.map((category) => <li><a href={`/productos/${category.slug}`}>{category.cta}</a></li>)}
      </ul>
    </section>

    <section class="state-directory-sidebar__widget state-directory-sidebar__widget--services">
      <p class="state-directory-sidebar__eyebrow">Servicios especializados</p>
      <ul class="state-directory-sidebar__link-list">
        {SERVICES.map((service) => <li><a href={`/servicios#${service.id}`}>{service.cta}</a></li>)}
      </ul>
    </section>

    <section class="state-directory-sidebar__widget state-directory-sidebar__widget--guides">
      <p class="state-directory-sidebar__eyebrow">Guías técnicas</p>
      <ul class="state-directory-sidebar__link-list">
        {guides.map((guide) => guide && <li><a href={`/guias/${guide.id}`}>{guide.data.keyword}</a></li>)}
      </ul>
      <a class="state-directory-sidebar__all-link" href="/guias">Ver todas las guías de protección</a>
    </section>

    <section class="state-directory-sidebar__widget state-directory-sidebar__widget--contact">
      <p>¿Buscas equipo para tu instalación?</p>
      <a href="/contacto">Cotizar equipo contra incendios</a>
    </section>
  </aside>
</div>

<style>
  .state-directory-layout { display: grid; gap: clamp(2rem, 4vw, 4.5rem); }
  .state-directory-sidebar { display: grid; min-width: 0; align-content: start; gap: var(--sp-4); }
  .state-directory-sidebar__widget { min-width: 0; padding: clamp(1.25rem, 2vw, 1.75rem); border: 1px solid var(--c-border); border-radius: var(--radius-md); background: var(--c-white); box-shadow: 0 12px 28px rgb(20 20 20 / .04); }
  .state-directory-sidebar__widget--intro { border-top: 3px solid var(--c-primary); }
  .state-directory-sidebar__eyebrow { margin: 0; color: var(--c-primary); font-size: .6875rem; font-weight: var(--weight-bold); letter-spacing: .11em; text-transform: uppercase; }
  .state-directory-sidebar h3 { margin: var(--sp-3) 0 0; color: var(--c-ink); font-family: var(--font-heading); font-size: var(--text-lg); letter-spacing: -.025em; line-height: 1.15; }
  .state-directory-sidebar__widget--intro > p:last-child { margin: var(--sp-3) 0 0; color: var(--c-muted); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .state-directory-sidebar__states, .state-directory-sidebar__link-list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; margin: var(--sp-3) 0 0; padding: 0; list-style: none; }
  .state-directory-sidebar__states { max-height: 20rem; overflow-y: auto; border-top: 1px solid var(--c-border); }
  .state-directory-sidebar__states li, .state-directory-sidebar__link-list li { min-width: 0; border-bottom: 1px solid var(--c-border); }
  .state-directory-sidebar__states a, .state-directory-sidebar__link-list a { display: block; padding: .7rem 0; color: var(--c-ink-2); font-size: var(--text-xs); font-weight: var(--weight-semibold); line-height: 1.35; text-decoration: none; }
  .state-directory-sidebar__link-list { margin-top: var(--sp-4); }
  .state-directory-sidebar__link-list a { color: var(--c-primary-dark); }
  .state-directory-sidebar__all-link { display: inline-flex; margin-top: var(--sp-4); color: var(--c-ink); font-size: var(--text-xs); font-weight: var(--weight-bold); text-decoration: none; border-bottom: 2px solid var(--c-primary); padding-bottom: .2rem; }
  .state-directory-sidebar__widget--contact { border-color: var(--c-primary); background: var(--c-primary); }
  .state-directory-sidebar__widget--contact p { margin: 0; color: var(--c-white); font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--weight-bold); letter-spacing: -.025em; line-height: 1.15; }
  .state-directory-sidebar__widget--contact a { display: inline-flex; margin-top: var(--sp-4); padding: .75rem 1rem; border-radius: var(--radius-sm); background: var(--c-white); color: var(--c-primary-dark); font-size: var(--text-xs); font-weight: var(--weight-bold); text-decoration: none; }
  .state-directory-sidebar a:focus-visible { outline: 2px solid var(--c-primary); outline-offset: 3px; }

  .state-directory-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1rem, 2vw, 1.5rem); }
  .state-directory-card { display: flex; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid var(--c-border); border-radius: var(--radius-md); background: var(--c-white); }
  .state-directory-card__media { overflow: hidden; aspect-ratio: 4 / 3; background: var(--c-ink); }
  .state-directory-card__image { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(.82) contrast(1.05); }
  .state-directory-card__body { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: flex-start; padding: clamp(1.25rem, 2vw, 1.75rem); }
  .state-directory-card__title { margin: 0; color: var(--c-ink); font-family: var(--font-heading); font-size: clamp(1.3rem, 1.1rem + .45vw, 1.65rem); font-weight: var(--weight-bold); letter-spacing: -.035em; line-height: 1.1; }
  .state-directory-card__description { margin: var(--sp-4) 0 0; color: var(--c-ink-2); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .state-directory-card__cta { display: inline-flex; min-height: 2.9rem; align-items: center; margin-top: auto; padding: .75rem 0 .15rem; border-bottom: 2px solid var(--c-primary); background: transparent; color: var(--c-primary-dark); font-family: var(--font-heading); font-size: var(--text-sm); font-weight: var(--weight-bold); line-height: 1.3; text-decoration: none; transition: border-color .2s ease, color .2s ease, transform .2s ease; }
  .state-directory-card__cta:focus-visible { outline: 3px solid color-mix(in srgb, var(--c-primary) 34%, var(--c-white)); outline-offset: 3px; }

  @media (hover: hover) {
    .state-directory-card__cta:hover { border-color: var(--c-primary-dark); color: var(--c-ink); transform: translateX(3px); }
    .state-directory-sidebar__states a:hover, .state-directory-sidebar__link-list a:hover, .state-directory-sidebar__all-link:hover { color: var(--c-primary-dark); }
    .state-directory-sidebar__widget--contact a:hover { color: var(--c-ink); }
  }

  @media (min-width: 840px) {
    .state-directory-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1180px) {
    .state-directory-layout.state-directory-layout--right { grid-template-columns: minmax(0, 1fr) minmax(17rem, 20rem); align-items: start; }
    .state-directory-sidebar { position: sticky; top: calc(var(--stack-height) + var(--sp-4)); }
    .state-directory-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

</style>
