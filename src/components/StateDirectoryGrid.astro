---
import { Picture } from 'astro:assets';
import type { DirectoryState } from '@config/site';
import { img } from '@lib/images';

interface Props {
  states: readonly DirectoryState[];
}

const { states } = Astro.props;
const visuals = [
  { image: img('directorio/atlas-papel-rojo.avif'), alt: 'Composición editorial abstracta de papel rojo con líneas de relieve', position: '50% 54%' },
  { image: img('directorio/atlas-grafito-rojo.avif'), alt: 'Composición editorial abstracta de papel grafito y retícula roja', position: '42% 50%' },
  { image: img('directorio/atlas-textil-rojo.avif'), alt: 'Composición editorial abstracta de textil técnico y una cinta roja', position: '58% 48%' },
  { image: img('directorio/atlas-papel-rojo.avif'), alt: 'Composición editorial abstracta de papel rojo con líneas de relieve', position: '72% 52%' },
  { image: img('directorio/atlas-grafito-rojo.avif'), alt: 'Composición editorial abstracta de papel grafito y retícula roja', position: '63% 42%' },
  { image: img('directorio/atlas-textil-rojo.avif'), alt: 'Composición editorial abstracta de textil técnico y una cinta roja', position: '34% 50%' },
] as const;
---

<div class="state-directory-grid" aria-label="Entidades federativas de México">
  {states.map((state, index) => {
    const visual = visuals[index % visuals.length];
    return (
      <article id={`estado-${state.slug}`} class="state-directory-card">
        <div class="state-directory-card__media">
          <Picture
            src={visual.image}
            formats={['avif', 'webp']}
            fallbackFormat="avif"
            widths={[400, 800]}
            sizes="(min-width: 1100px) 32vw, (min-width: 720px) 50vw, 100vw"
            alt={visual.alt}
            width={800}
            height={500}
            loading={index < 3 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            decoding="async"
            class="state-directory-card__image"
            style={`object-position: ${visual.position}`}
            quality={65}
          />
        </div>
        <div class="state-directory-card__body">
          <h3 class="state-directory-card__title">{state.label}</h3>
          <p class="state-directory-card__status">Esta ficha integrará fuentes institucionales verificables.</p>
          <button class="state-directory-card__cta" type="button" disabled>Directorio estatal en preparación</button>
        </div>
      </article>
    );
  })}
</div>

<style>
  .state-directory-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); }
  .state-directory-card { display: flex; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid var(--c-border); border-radius: var(--radius-lg); background: var(--c-white); }
  .state-directory-card__media { aspect-ratio: 8 / 5; overflow: hidden; background: var(--c-surface); }
  .state-directory-card__image { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .45s cubic-bezier(.16, 1, .3, 1); }
  .state-directory-card__body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: var(--sp-3); padding: var(--sp-5); }
  .state-directory-card__title { margin: 0; color: var(--c-ink); font-family: var(--font-heading); font-size: clamp(1.25rem, 1.8vw, 1.7rem); font-weight: var(--weight-bold); letter-spacing: -.025em; line-height: var(--leading-snug); }
  .state-directory-card__status { margin: 0; color: var(--c-muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
  .state-directory-card__cta { width: 100%; margin-top: auto; padding: .72rem 1rem; border: 1px solid var(--c-border); border-radius: var(--radius-sm); background: var(--c-surface); color: var(--c-muted); font-family: var(--font-heading); font-size: var(--text-sm); font-weight: var(--weight-semibold); line-height: 1.2; text-align: left; }
  .state-directory-card__cta:disabled { cursor: not-allowed; opacity: 1; }

  @media (hover: hover) {
    .state-directory-card { transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease; }
    .state-directory-card:hover { border-color: color-mix(in srgb, var(--c-primary) 38%, var(--c-border)); box-shadow: var(--shadow-md); transform: translateY(-3px); }
    .state-directory-card:hover .state-directory-card__image { transform: scale(1.035); }
    .state-directory-card:active { transform: translateY(-1px); }
  }

  @media (min-width: 720px) {
    .state-directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .state-directory-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .state-directory-card:nth-child(6n + 1), .state-directory-card:nth-child(6n + 5) { grid-column: span 5; }
    .state-directory-card:nth-child(6n + 2), .state-directory-card:nth-child(6n + 6) { grid-column: span 3; }
    .state-directory-card:nth-child(6n + 3), .state-directory-card:nth-child(6n + 4) { grid-column: span 4; }
    .state-directory-card:nth-child(6n + 2) .state-directory-card__media, .state-directory-card:nth-child(6n + 6) .state-directory-card__media { aspect-ratio: 4 / 3; }
  }
</style>
