---
import Icon from '@components/Icon.astro'

interface StageLink { label: string; href: string }
interface StageItem { num: string; title: string; desc: string; links: StageLink[] }
interface Props { items: StageItem[] }

const { items } = Astro.props
---

<div class="grid-4 stage-grid">
  {items.map((item) => (
    <article class="stage-card">
      <span class="stage-card__num" aria-hidden="true">{item.num}</span>
      <h3 class="stage-card__title">{item.title}</h3>
      <p class="stage-card__desc">{item.desc}</p>
      {item.links.length > 0 && (
        <ul class="stage-card__links" aria-label={`Productos de ${item.title}`}>
          {item.links.map((link) => (
            <li>
              <a href={link.href}>
                {link.label}
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </article>
  ))}
</div>

<style>
  .stage-grid { align-items: stretch; }
  .stage-card { display: flex; flex-direction: column; height: 100%; padding: var(--sp-5); border: 1px solid var(--c-border); border-radius: var(--radius-lg); background: var(--c-white); box-shadow: var(--shadow-sm); }
  .stage-card__num { color: var(--c-primary); font-family: var(--font-heading); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: var(--weight-black); line-height: 1; }
  .stage-card__title { margin: var(--sp-5) 0 var(--sp-3); font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--weight-semibold); line-height: var(--leading-snug); color: var(--c-ink); }
  .stage-card__desc { margin: 0 0 var(--sp-5); color: var(--c-ink-2); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .stage-card__links { display: flex; flex-direction: column; gap: var(--sp-2); margin: auto 0 0; padding: 0; list-style: none; }
  .stage-card__links a { display: inline-flex; align-items: flex-start; gap: var(--sp-2); color: var(--c-primary-dark); font-size: var(--text-sm); font-weight: var(--weight-semibold); line-height: var(--leading-snug); text-decoration: none; }
  .stage-card__links a:hover { text-decoration: underline; }
  .stage-card__links :global(svg) { flex: 0 0 auto; margin-top: .1em; }
</style>
