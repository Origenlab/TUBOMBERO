---
import CategoryCard from './CategoryCard.astro';
interface StageLink { label: string; href: string }
interface StageItem { title: string; desc: string; links: StageLink[] }
interface Props { items: StageItem[] }
const { items } = Astro.props;
---
<ol class="grid-4 stage-grid" aria-label="Elementos de la sección">
  {items.map((item, index) => {
    const [primary, ...related] = item.links;
    const href = primary?.href ?? '/contacto';
    const ctaLabel = primary ? `Ver ${primary.label.toLocaleLowerCase('es-MX')}` : 'Solicitar asesoría';
    return <li><CategoryCard label={item.title} blurb={item.desc} href={href} badge={String(index + 1).padStart(2, '0')} ctaLabel={ctaLabel}>
      {related.length > 0 && <ul class="related-links">{related.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
    </CategoryCard></li>;
  })}
</ol>
<style>
  .stage-grid { margin: 0; padding: 0; list-style: none; }
  .stage-grid > li { min-width: 0; }
  .related-links { margin: 0; padding-left: var(--sp-4); font-size: var(--text-sm); }
  .related-links a { color: var(--c-primary-dark); }
</style>
