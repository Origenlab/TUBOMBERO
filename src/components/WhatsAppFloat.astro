---
// WhatsAppFloat.astro — Botón flotante fijo de WhatsApp (verde var(--c-wa)), global en el layout. ORIGEN: PROYECTORED/src/components/global/WhatsAppButton.astro (lee waUrl + WA_MESSAGES, etiqueta colapsable en móvil).
// Contrato: usa waUrl() y WA_MESSAGES desde config/site. NUNCA número hardcodeado (anti-patrón BRINCOLINS/MESASPICNIC: wa.me hardcoded ×6).
import { waUrl, WA_MESSAGES } from '@config/site'
import Icon from '@components/Icon.astro'

interface Props {
  /** Clave de WA_MESSAGES a usar (default 'default'). */
  message?: keyof typeof WA_MESSAGES
  /** Texto de la etiqueta visible junto al ícono. */
  label?: string
}
const { message = ('default' in WA_MESSAGES ? 'default' : Object.keys(WA_MESSAGES)[0]) as keyof typeof WA_MESSAGES, label = '¿Necesitas ayuda?' } = Astro.props
const href = waUrl(WA_MESSAGES[message])
---

{href && (<a href={href} class="wa-float" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" title={label}>
  <Icon name="whatsapp" size={26} />
  <span class="wa-float__label">{label}</span>
</a>)}

<style>
  .wa-float {
    position: fixed;
    bottom: var(--sp-6, 1.5rem);
    right: var(--sp-6, 1.5rem);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: var(--sp-2, .5rem);
    padding: var(--sp-3, .75rem) var(--sp-4, 1rem);
    background: var(--c-wa);
    color: var(--c-white);
    border-radius: var(--radius-full, 9999px);
    box-shadow: 0 4px 16px rgba(37,211,102,.4);
    font-size: var(--text-sm, .875rem);
    font-weight: var(--weight-semibold, 600);
    transition: transform .2s ease, box-shadow .2s ease;
    text-decoration: none;
    /* respeta el notch / barra inferior iOS */
    margin-bottom: env(safe-area-inset-bottom, 0px);
  }
  .wa-float:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 6px 20px rgba(37,211,102,.5); }
  .wa-float:focus-visible { outline: 3px solid rgba(37,211,102,.5); outline-offset: 2px; }
  @media (max-width: 640px) {
    .wa-float__label { display: none; }
    .wa-float {
      width: 52px; height: 52px; padding: 0; justify-content: center;
      bottom: max(1rem, env(safe-area-inset-bottom));
      right: max(1rem, env(safe-area-inset-right));
    }
  }
  body.menu-open .wa-float { display: none; }
</style>
