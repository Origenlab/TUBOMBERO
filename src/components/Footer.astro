---
import { CATEGORIES, CONTACT, LEGAL, SERVICES, SITE } from '@config/site';
---
<footer id="contacto" class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="brand" href="/" aria-label={`${SITE.name}, inicio`}><span class="brand__mark" aria-hidden="true">T</span><span class="brand__name">Tu <strong>Bombero</strong></span></a>
      <p>{SITE.description}</p>
      <p class="footer__status">{SITE.contactStatus}</p>
    </div>
    <div><h2>Productos</h2><ul>{CATEGORIES.map((item) => <li><a href={`/productos/${item.slug}`}>{item.label}</a></li>)}</ul></div>
    <div><h2>Servicios</h2><ul>{SERVICES.map((item) => <li><a href="/servicios">{item.label}</a></li>)}</ul></div>
    <div class="footer__contact"><h2>Contacto</h2>{CONTACT.email && <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>}{CONTACT.phone && <a href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phone}</a>}{!CONTACT.email && !CONTACT.phone && <p>{SITE.contactStatus}</p>}</div>
  </div>
  <div class="container footer__bottom"><span>© {new Date().getFullYear()} {SITE.name}. Todos los derechos reservados.</span><nav aria-label="Enlaces legales">{LEGAL.map((item) => <a href={item.href}>{item.label}</a>)}</nav></div>
</footer>
<style>
  .footer { background: var(--c-ink); color: var(--c-white); padding-top: var(--sp-10); }
  .footer__grid { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: var(--sp-8); padding-bottom: var(--sp-8); }
  .footer .brand { color: var(--c-white); }
  .footer__brand p, .footer__contact p { max-width: 30ch; color: rgb(255 255 255 / .65); line-height: var(--leading-relaxed); }
  .footer__status { color: var(--c-primary-light) !important; font-weight: var(--weight-semibold); }
  .footer h2 { margin: 0 0 var(--sp-3); font-family: var(--font-heading); font-size: var(--text-sm); }
  .footer ul { display: grid; gap: var(--sp-2); margin: 0; padding: 0; list-style: none; }
  .footer a { color: rgb(255 255 255 / .72); font-size: var(--text-sm); text-decoration: none; }
  .footer a:hover { color: var(--c-white); }
  .footer__contact { display: grid; align-content: start; gap: var(--sp-2); }
  .footer__bottom { display: flex; justify-content: space-between; gap: var(--sp-4); padding-block: var(--sp-4); border-top: 1px solid rgb(255 255 255 / .14); color: rgb(255 255 255 / .58); font-size: var(--text-xs); }
  .footer__bottom nav { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin: 0; }
  @media (max-width: 768px) { .footer__grid { grid-template-columns: repeat(2, 1fr); } .footer__brand { grid-column: 1 / -1; } .footer__bottom { flex-direction: column; } }
</style>
