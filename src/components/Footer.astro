---
import Icon from '@components/Icon.astro';
import { SITE, CONTACT, PRODUCT_CATEGORIES, SERVICES, SECTORS, LEGAL, contextualCta, waUrl, telUrl, WA_MESSAGES } from '@config/site';
import { getGuides } from '@lib/guides';

const guides = await getGuides();
const currentYear = new Date().getFullYear();
const waDefault = waUrl(WA_MESSAGES.cotizacion ?? WA_MESSAGES.default);
const footerCtaLabel = contextualCta(Astro.url.pathname);
const telLink = telUrl();
const currentPath = Astro.url.pathname.replace(/\/index\.html$/i, '/').replace(/\.html$/i, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => currentPath === href ? 'page' as const : undefined;
---

<footer id="contacto" class="footer" aria-label="Pie de página">
  <div class="footer__intro">
    <div class="container footer__intro-grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label={`${SITE.brand}, inicio`}>
          <span class="footer__logo-mark" aria-hidden="true">TB<span>.</span></span>
          <span>{SITE.brand}<small>{SITE.tagline}</small></span>
        </a>
        <p>{SITE.description}</p>
        <span class="footer__coverage">Cobertura comercial prevista: Toda la República Mexicana.</span>
      </div>
      <div class="footer__invitation">
        <p class="footer__eyebrow">De la consulta al proyecto</p>
        <h2>Encuentra el equipo.<br />Define el siguiente paso.</h2>
        <div class="footer__actions">
          <a href="/contacto" class="footer__button">{footerCtaLabel}<Icon name="arrow-right" size={18} /></a>
          {waDefault && <a href={waDefault} class="footer__whatsapp" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={20} />Solicitar asesoría por WhatsApp</a>}
        </div>
      </div>
    </div>
  </div>

  <div class="footer__body">
    <div class="container footer__grid">
      <nav class="footer__col" aria-labelledby="footer-products">
        <h2 id="footer-products"><span aria-hidden="true">01</span> Productos</h2>
        <ul>
          {PRODUCT_CATEGORIES.map((cat) => <li><a href={`/productos/${cat.slug}`} aria-current={isCurrent(`/productos/${cat.slug}`)}>{cat.label}</a></li>)}
        </ul>
        <a href="/productos" class="footer__hub" aria-current={isCurrent('/productos')}>Catálogo de equipo contra incendios<Icon name="arrow-right" size={16} /></a>
      </nav>
      <nav class="footer__col" aria-labelledby="footer-solutions">
        <h2 id="footer-solutions"><span aria-hidden="true">02</span> Servicios y sectores</h2>
        <ul>{SERVICES.map((svc) => <li><a href={`/servicios#${svc.id}`}>{svc.label}</a></li>)}</ul>
        <a href="/servicios" class="footer__hub" aria-current={isCurrent('/servicios')}>Todos los servicios<Icon name="arrow-right" size={16} /></a>
        <h3>Por tipo de organización</h3>
        <ul>{SECTORS.map((sec) => <li><a href={`/sectores#sector-${sec.slug}`}>{sec.label}</a></li>)}</ul>
        <a href="/sectores" class="footer__hub" aria-current={isCurrent('/sectores')}>Sectores de protección contra incendios<Icon name="arrow-right" size={16} /></a>
      </nav>
      <nav class="footer__col" aria-labelledby="footer-resources">
        <h2 id="footer-resources"><span aria-hidden="true">03</span> Guías y directorio</h2>
        <ul>{guides.map((guide) => guide && <li><a href={`/guias/${guide.id}`} aria-current={isCurrent(`/guias/${guide.id}`)}>{guide.data.keyword.charAt(0).toLocaleUpperCase('es-MX') + guide.data.keyword.slice(1)}</a></li>)}</ul>
        <a href="/guias" class="footer__hub" aria-current={isCurrent('/guias')}>Guías de protección contra incendios<Icon name="arrow-right" size={16} /></a>
        <div class="footer__resource">
          <h3>Directorio de bomberos</h3>
          <p>Consulta estaciones y fuentes institucionales por estado.</p>
          <a href="/directorio" class="footer__hub" aria-current={isCurrent('/directorio')}>Directorio de bomberos en México<Icon name="arrow-right" size={16} /></a>
        </div>
      </nav>
      <div class="footer__col">
        <nav aria-labelledby="footer-company">
          <h2 id="footer-company"><span aria-hidden="true">04</span> Empresa y contacto</h2>
          <ul>
            <li><a href="/nosotros" aria-current={isCurrent('/nosotros')}>Conoce Tu Bombero</a></li>
            <li><a href="/contacto" aria-current={isCurrent('/contacto')}>Contacto y cotizaciones</a></li>
          </ul>
        </nav>
        <address class="footer__contact">
          <span class="footer__eyebrow">Hablemos de tu proyecto</span>
          {telLink && <a href={telLink} class="footer__phone">{CONTACT.phone}<Icon name="arrow-right" size={18} /></a>}
          {waDefault && <a href={waDefault} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp<Icon name="whatsapp" size={16} /></a>}
          {CONTACT.email && <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>}
          {!telLink && !waDefault && <p>{SITE.contactStatus}</p>}
        </address>
        <p class="footer__contact-note">Comparte el tipo de inmueble, el equipo que buscas y las necesidades de tu proyecto.</p>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {currentYear} {SITE.name}. Todos los derechos reservados.</p>
      <nav aria-label="Enlaces legales">{LEGAL.map((item) => <a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>)}</nav>
      <a class="footer__top" href="#main-content">Contenido principal<Icon name="arrow-up" size={16} /></a>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--c-ink); color: #c2c2c2; border-top: 4px solid var(--c-primary); }
  .footer a { text-decoration: none; }
  .footer a:focus-visible { outline: 2px solid #fff; outline-offset: 5px; border-radius: 2px; }
  .footer__intro { border-bottom: 1px solid #383838; }
  .footer__intro-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .footer__logo { display: inline-flex; align-items: center; gap: 1rem; color: #fff; font-size: 1.5rem; font-weight: 800; letter-spacing: -.04em; }
  .footer__logo-mark { display: grid; place-content: center; position: relative; width: 3.5rem; height: 3.5rem; border: 1px solid #555; border-radius: var(--radius-sm); font-size: 1.35rem; }
  .footer__logo-mark span { position: absolute; right: .3rem; bottom: .25rem; color: var(--c-primary-light); }
  .footer__logo small { display: block; margin-top: .4rem; color: #bcbcbc; font-size: .75rem; font-weight: 400; letter-spacing: 0; }
  .footer__brand p { max-width: 43ch; margin: 1.4rem 0 1rem; font-size: .9375rem; line-height: 1.7; }
  .footer__coverage { display: block; max-width: 45ch; font-size: .75rem; line-height: 1.7; color: #aaa; }
  .footer__eyebrow { margin: 0 0 1rem; color: #f6979a; font-size: .6875rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .footer__invitation h2 { margin: 0; color: #fff; font-size: clamp(1.7rem, 3vw, 2.75rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.15; }
  .footer__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 1.75rem; }
  .footer__button, .footer__whatsapp { display: inline-flex; align-items: center; gap: .75rem; min-height: 2.75rem; font-size: .8125rem; font-weight: 600; color: #fff; }
  .footer__button { padding: .85rem 1.2rem; border-radius: var(--radius-sm); background: var(--c-primary); transition: background .2s; }
  .footer__button:hover { background: var(--c-primary-dark); }
  .footer__whatsapp:hover { text-decoration: underline; text-underline-offset: .3em; }
  .footer__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); padding-block: 3.5rem; }
  .footer__col { min-width: 0; }
  .footer__col h2 { display: flex; align-items: baseline; gap: .6rem; margin: 0 0 1.35rem; color: #fff; font-size: .9375rem; font-weight: 600; }
  .footer__col h2 span { color: #f6979a; font-size: .6875rem; font-variant-numeric: tabular-nums; }
  .footer__col h3 { margin: 1.75rem 0 .75rem; color: #fff; font-size: .8125rem; font-weight: 600; }
  .footer__col ul { list-style: none; margin: 0; padding: 0; }
  .footer__col li a { display: flex; align-items: center; min-height: 2.5rem; padding-block: .4rem; color: #bcbcbc; font-size: .8125rem; line-height: 1.5; }
  .footer__col a:hover, .footer__col a[aria-current="page"] { color: #fff; text-decoration: underline; text-decoration-color: #f6979a; text-underline-offset: .3em; }
  .footer__hub { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 2.75rem; margin-top: .75rem; padding-top: .65rem; border-top: 1px solid #383838; color: #f6979a; font-size: .8125rem; font-weight: 600; }
  .footer__resource { margin-top: 1.75rem; }
  .footer__resource p, .footer__contact-note { font-size: .8125rem; line-height: 1.7; color: #aaa; }
  .footer__contact { display: flex; flex-direction: column; gap: .75rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #383838; font-style: normal; }
  .footer__contact .footer__eyebrow { margin: 0; }
  .footer__contact a { display: flex; align-items: center; justify-content: space-between; gap: .5rem; min-height: 2.75rem; color: #fff; font-size: .8125rem; overflow-wrap: anywhere; }
  .footer__contact .footer__phone { font-size: clamp(1.15rem, 1.7vw, 1.5rem); font-weight: 600; letter-spacing: -.03em; }
  .footer :global(svg) { flex-shrink: 0; }
  .footer__bottom { border-top: 1px solid #383838; background: var(--c-black); }
  .footer__bottom-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .75rem 2rem; padding-block: 1.25rem; font-size: .75rem; }
  .footer__bottom p { margin: 0; }
  .footer__bottom nav { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
  .footer__bottom a { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; color: #bcbcbc; }
  .footer__bottom a:hover { color: #fff; text-decoration: underline; text-underline-offset: .3em; }
  @media (max-width: 1023px) { .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; } }
  @media (max-width: 640px) {
    .footer__intro-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .footer__invitation { padding-top: 2rem; border-top: 1px solid #383838; }
    .footer__grid { gap: 2rem 1.25rem; padding-block: 2.5rem; }
    .footer__col li a { min-height: 2.75rem; }
    .footer__bottom-inner { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 420px) { .footer__grid { grid-template-columns: 1fr; } .footer__col + .footer__col { border-top: 1px solid #383838; padding-top: 1.75rem; } }
</style>
