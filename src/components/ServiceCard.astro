---
// ServiceCard.astro — Tarjeta de servicio: ícono opcional + título + descripción + CTA (página interna o WhatsApp). ORIGEN: PROYECTORED .ccard de CatalogoServicios + ServiceCard de MESASPICNIC (icon/badge), normalizado a tokens.
// Si href apunta a WhatsApp, construye el href con waUrl(WA_MESSAGES.x) desde config y pasa whatsapp={true}. NUNCA número hardcodeado.
import { Picture } from 'astro:assets';
import Icon from '@components/Icon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  id?: string
  title: string
  description: string
  href: string
  /** SVG inline (string) para el ícono. Opcional. */
  icon?: string
  /** Imagen de cabecera. Si se pasa, reemplaza al ícono superior. */
  image?: ImageMetadata
  imageAlt?: string
  badge?: string
  ctaLabel?: string
  /** true → CTA estilo WhatsApp (verde) + target _blank. */
  whatsapp?: boolean
}
const { id, title, description, href, icon, image, imageAlt, badge, ctaLabel = title, whatsapp = false } = Astro.props
---

<article id={id} class="scard" aria-label={title}>
  {image ? (
    <div class="scard__media">
      <Picture src={image} alt={imageAlt ?? title} width={640} height={360} widths={[400, 640]} sizes="(min-width:1100px) 25vw, (min-width:640px) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="avif" loading="lazy" decoding="async" class="scard__img" quality={60} />
      <span class="scard__overlay" aria-hidden="true"></span>
      {badge && <span class="scard__badge">{badge}</span>}
    </div>
  ) : icon ? (
    <div class="scard__icon" aria-hidden="true"><Fragment set:html={icon} /></div>
  ) : null}

  <div class="scard__body">
    {badge && !image && <span class="scard__badge scard__badge--inline">{badge}</span>}
    <h3 class="scard__title">{title}</h3>
    <p class="scard__desc">{description}</p>
    <a
      href={href}
      class:list={['scard__cta', whatsapp && 'scard__cta--wa']}
      target={whatsapp || href.startsWith('http') ? '_blank' : undefined}
      rel={whatsapp || href.startsWith('http') ? 'noopener noreferrer' : undefined}
    >
      {whatsapp && <Icon name="whatsapp" size={16} />}
      {ctaLabel}
      {!whatsapp && <Icon name="arrow-right" size={14} />}
    </a>
  </div>
</article>

<style>
  /* Card ESTÁTICA: sin animaciones ni transiciones (regla de motion). */
  .scard { display: flex; flex-direction: column; background: var(--c-white, var(--c-white)); border: 1px solid var(--c-border, var(--border, var(--c-border))); border-radius: var(--radius-xl, 1rem); overflow: hidden; height: 100%; }
  .scard__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-gray-100, var(--c-surface)); }
  .scard__img { width: 100%; height: 100%; object-fit: cover; }
  .scard__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,.18) 100%); }
  .scard__badge { position: absolute; top: var(--sp-3, .75rem); left: var(--sp-3, .75rem); font-size: var(--text-xs, .6875rem); font-weight: var(--weight-bold, 700); letter-spacing: .04em; text-transform: uppercase; color: var(--c-white); background: var(--color-red, var(--c-primary, var(--c-primary))); padding: .25rem .55rem; border-radius: var(--radius-sm, .25rem); }
  .scard__badge--inline { position: static; display: inline-block; align-self: flex-start; margin-bottom: var(--sp-3, .75rem); }
  .scard__icon { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; margin: var(--sp-5, 1.25rem) var(--sp-5, 1.25rem) 0; border-radius: var(--radius-lg, .75rem); background: color-mix(in srgb, var(--c-primary) 12%, var(--c-white)); color: var(--color-red, var(--c-primary)); }
  .scard__body { display: flex; flex-direction: column; flex-grow: 1; padding: var(--sp-5, 1.25rem); }
  .scard__title { font-size: var(--text-lg, 1.125rem); font-weight: var(--weight-semibold, 600); line-height: var(--leading-snug, 1.35); color: var(--c-ink, var(--color-gray-900, var(--c-ink-2))); margin: 0 0 var(--sp-2, .5rem); }
  .scard__desc { font-size: var(--text-sm, .9375rem); color: var(--text-muted, var(--c-muted, var(--c-muted))); line-height: var(--leading-normal, 1.5); margin: 0 0 auto; }
  /* Único elemento que anima: el botón CTA. */
  .scard__cta { display: inline-flex; align-items: center; gap: var(--sp-2, .5rem); margin-top: var(--sp-4, 1rem); font-size: var(--text-sm, .875rem); font-weight: var(--weight-semibold, 600); color: var(--color-red, var(--c-primary, var(--c-primary))); text-decoration: none; align-self: flex-start; transition: color var(--transition, .18s ease), gap var(--transition, .18s ease), background var(--transition, .18s ease); }
  .scard:hover .scard__cta:not(.scard__cta--wa) { gap: .65rem; color: var(--color-red-dark, var(--c-primary-dark, var(--c-primary-dark))); }
  .scard__cta--wa { color: var(--c-white); background: var(--c-wa); padding: .55rem 1rem; border-radius: var(--radius-md, 6px); }
  .scard__cta--wa:hover { background: var(--c-wa); }
  .scard__cta:focus-visible { outline: 2px solid var(--color-red, var(--c-primary, var(--c-primary))); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .scard__cta { transition: none; } }
</style>
