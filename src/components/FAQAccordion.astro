---
export interface FAQItem {
  question: string
  answer: string
}
interface Props {
  items: FAQItem[]
  title?: string
  headingId?: string
  emitSchema?: boolean
  openFirst?: boolean
  bare?: boolean
}
const { items = [], title = 'Preguntas frecuentes', headingId = 'faq-heading', emitSchema = false, openFirst = true, bare = false } = Astro.props

const faqSchema = emitSchema ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') },
  })),
} : null
---

<section class:list={['faq', bare && 'faq--bare']} aria-labelledby={title ? headingId : undefined}>
  <div class="faq__inner">
    {title && <h2 id={headingId} class="faq__title">{title}</h2>}
    <div class="faq__list">
      {items.map((item, idx) => (
        <details class="faq__item" open={openFirst && idx === 0}>
          <summary class="faq__q">
            <span>{item.question}</span>
            <svg class="faq__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="faq__a"><p set:html={item.answer} /></div>
        </details>
      ))}
    </div>
  </div>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</section>

<style>
  .faq { padding: var(--section-py, clamp(3rem, 6vw, 5rem)) 0; }
  .faq__inner { max-width: 820px; margin-inline: auto; padding-inline: var(--container-px, 1.5rem); }
  .faq__title { font-size: var(--text-3xl, clamp(2rem, 3.5vw, 3rem)); font-weight: var(--weight-bold, 700); margin: 0 0 var(--sp-8, 2rem); text-align: center; color: var(--c-ink); }
  .faq__list { display: flex; flex-direction: column; gap: var(--sp-3, .75rem); }
  .faq__item { border: var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--c-white); }
  .faq__q { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3); padding: var(--sp-4) var(--sp-5); cursor: pointer; background: var(--c-surface); font-weight: var(--weight-semibold); color: var(--c-ink); list-style: none; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { background: var(--c-surface-2); }
  .faq__item[open] .faq__q { background: var(--c-surface); }
  .faq--bare { padding: 0; }
  .faq--bare .faq__inner { max-width: none; padding-inline: 0; }
  .faq__chevron { flex-shrink: 0; transition: transform .2s ease; color: var(--c-primary); }
  .faq__item[open] .faq__chevron { transform: rotate(180deg); }
  .faq__a { padding: var(--sp-4) var(--sp-5); color: var(--c-ink-2); line-height: var(--leading-relaxed); border-top: var(--border); }
  .faq__a :global(p) { margin: 0; }
  .faq__a :global(a) { color: var(--c-primary); }
  @media (prefers-reduced-motion: reduce) { .faq__chevron { transition: none; } }
</style>
