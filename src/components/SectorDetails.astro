---
import CategoryCard from './CategoryCard.astro';
import { SECTORS } from '@config/site';
interface Item { slug: string; summary: string; points: string[]; links: { label: string; href: string }[] }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="sector-details">
  {items.map((item) => {
    const sector = SECTORS.find((entry) => entry.slug === item.slug);
    if (!sector) return null;
    return <CategoryCard id={`sector-${item.slug}`} label={sector.label} image={sector.image} imageAlt={sector.imageAlt} blurb={item.summary} href="/contacto" ctaLabel="Solicitar cotización del proyecto" linkContent={false}>
      <p class="points-label">Puntos de atención</p>
      <ul class="points">{item.points.map((point) => <li>{point}</li>)}</ul>
      <ul class="links" aria-label={`Enlaces de ${sector.label}`}>
        {item.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </CategoryCard>;
  })}
</div>
<style>
  .sector-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-5); }
  .sector-details :global(.ccard) { scroll-margin-top: calc(var(--stack-height) + var(--sp-4)); }
  .sector-details :global(.ccard__desc) { display: block; overflow: visible; }
  .points-label { margin: 0; font-weight: var(--weight-semibold); font-size: var(--text-sm); }
  .points, .links { margin: 0; padding-left: var(--sp-4); color: var(--c-ink-2); font-size: var(--text-sm); }
  .points li, .links li { margin-bottom: var(--sp-2); }
  .links a { color: var(--c-primary-dark); }
  @media (max-width: 767px) { .sector-details { grid-template-columns: 1fr; } }
</style>
