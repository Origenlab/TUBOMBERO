---
import Icon from '@components/Icon.astro';
import { SECTORS } from '@config/site';

interface Item { slug: string; summary: string; points: string[]; links: { label: string; href: string }[] }
interface Props { items: Item[] }
const { items } = Astro.props;
---

<div class="sector-details">
  {items.map((item) => {
    const sector = SECTORS.find((entry) => entry.slug === item.slug);
    if (!sector) return null;
    return (
      <article id={`sector-${item.slug}`} class="sector-detail">
        <header class="sector-detail__header"><span class="sector-detail__icon" aria-hidden="true"><Icon name={sector.icon} size={24} /></span><h3>{sector.label}</h3></header>
        <p class="sector-detail__summary">{item.summary}</p>
        <p class="sector-detail__label">Puntos de atención</p>
        <ul class="sector-detail__points">{item.points.map((point) => <li>{point}</li>)}</ul>
        <ul class="sector-detail__links" aria-label={`Enlaces de ${sector.label}`}>
          {item.links.map((link) => <li><a href={link.href}>{link.label}<Icon name="arrow-right" size={16} /></a></li>)}
        </ul>
      </article>
    );
  })}
</div>

<style>
  .sector-details { display: grid; grid-template-columns: 1fr; gap: var(--sp-5); }
  .sector-detail { display: flex; flex-direction: column; height: 100%; padding: var(--sp-5); border: 1px solid var(--c-border); border-radius: var(--radius-lg); background: var(--c-white); box-shadow: var(--shadow-sm); scroll-margin-top: calc(var(--stack-height) + var(--sp-4)); }
  .sector-detail__header { display: flex; align-items: center; gap: var(--sp-3); }
  .sector-detail__icon { display: grid; place-items: center; flex: 0 0 auto; width: 2.75rem; height: 2.75rem; border-radius: var(--radius-md); background: var(--c-primary); color: var(--c-white); }
  .sector-detail h3 { margin: 0; font-family: var(--font-heading); font-size: var(--text-lg); line-height: var(--leading-snug); color: var(--c-ink); }
  .sector-detail__summary { margin: var(--sp-4) 0 var(--sp-5); color: var(--c-ink-2); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .sector-detail__label { margin: 0 0 var(--sp-2); color: var(--c-primary); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: .08em; text-transform: uppercase; }
  .sector-detail__points { display: flex; flex-direction: column; gap: var(--sp-2); margin: 0; padding: 0; list-style: none; color: var(--c-ink-2); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .sector-detail__points li { position: relative; padding-left: var(--sp-4); }
  .sector-detail__points li::before { position: absolute; top: .7em; left: 0; width: .4rem; height: .4rem; border-radius: 50%; background: var(--c-primary); content: ''; }
  .sector-detail__links { display: flex; flex-direction: column; gap: var(--sp-2); margin: auto 0 0; padding: var(--sp-5) 0 0; list-style: none; }
  .sector-detail__links a { display: inline-flex; align-items: flex-start; gap: var(--sp-2); color: var(--c-primary-dark); font-size: var(--text-sm); font-weight: var(--weight-semibold); line-height: var(--leading-snug); text-decoration: none; }
  .sector-detail__links a:hover { text-decoration: underline; }
  .sector-detail__links :global(svg) { flex: 0 0 auto; margin-top: .1em; }
  @media (min-width: 1024px) { .sector-details { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
