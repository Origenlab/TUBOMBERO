---
// TopBar.astro — Barra utilitaria superior del sistema Ejemplos.mx.
// ============================================================================
// Primer eslabón del CHROME STICKY: topbar (top:0) + header (top:--topbar-height)
// forman un stack pegajoso coherente (ver --stack-height en tokens.css). El menú
// y el contacto quedan SIEMPRE a la vista; en móvil ya no aparece una píldora
// suelta: el contacto se reparte en dos acciones de igual peso (llamar · WhatsApp).
//
// SSoT: TODO el contenido sale de src/config/site.ts (SITE / CONTACT / WA_MESSAGES).
// Los enlaces se arman con telUrl() y waUrl() — NUNCA un `tel:` o `wa.me` a mano
// (regla dura D4). Cambias el dato en site.ts y se actualiza en todo el sitio.
//
// MODO GUÍA (prop `guia`): numera cada punto de la barra y añade debajo una
// leyenda que explica QUÉ va en cada lugar y DE QUÉ DATO sale. En un sitio de
// cliente se usa <TopBar /> (sin `guia`) y la leyenda desaparece por completo.
// ============================================================================
import { SITE, CONTACT, waUrl, telUrl, WA_MESSAGES } from '@config/site'
import Icon from '@components/Icon.astro'

interface Props {
  /** Modo guía: marcadores numerados + leyenda explicativa por punto. Default false (producción). */
  guia?: boolean
}
const { guia = false } = Astro.props
const schedule = CONTACT.schedule?.display as string | undefined

// Puntos del topbar — fuente única de la leyenda (vive junto al markup que documenta).
const PUNTOS = [
  {
    n: 1,
    nombre: 'Propuesta principal',
    que: 'Lo primero que se lee: una frase corta que posiciona la marca. El logotipo NO va aquí — va en el Header, justo debajo.',
    dato: 'SITE.tagline',
  },
  {
    n: 2,
    nombre: 'Horario',
    que: 'Señal de disponibilidad y confianza. Se oculta en móvil para priorizar el teléfono y WhatsApp.',
    dato: 'CONTACT.schedule.display',
  },
  {
    n: 3,
    nombre: 'Teléfono',
    que: 'Contacto directo con clic-para-llamar. El enlace tel: lo construye telUrl(), no se escribe a mano.',
    dato: 'CONTACT.phone · telUrl()',
  },
  {
    n: 4,
    nombre: 'WhatsApp',
    que: 'CTA principal de contacto. El enlace SIEMPRE se arma con waUrl(); el mensaje precargado sale de WA_MESSAGES.',
    dato: 'waUrl(WA_MESSAGES.cotizar)',
  },
]
---

<aside class:list={['topbar', { 'is-guia': guia }]} aria-label="Información de contacto">
  <div class="tb-inner">
    <p class="tb-promo">
      {guia && <span class="tb-mark" aria-hidden="true">1</span>}
      <span class="tb-spark" aria-hidden="true"></span>
      <span class="tb-promo__txt">{SITE.tagline}</span>
    </p>

    <div class="tb-actions">
      {schedule && (
        <span class="tb-item tb-schedule">
          {guia && <span class="tb-mark" aria-hidden="true">2</span>}
          <Icon name="clock" size={14} class="tb-ico" />
          <span class="tb-item__txt">{schedule}</span>
        </span>
      )}

      {telUrl() && <a href={telUrl()} class="tb-item tb-phone" aria-label={`Llamar al ${CONTACT.phone}`}>
        {guia && <span class="tb-mark" aria-hidden="true">3</span>}
        <Icon name="phone" size={14} class="tb-ico" />
        <span class="tb-item__txt">{CONTACT.phone}</span>
      </a>}

      {waUrl(WA_MESSAGES.cotizar) && <a href={waUrl(WA_MESSAGES.cotizar)} class="tb-item tb-wa" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
        {guia && <span class="tb-mark" aria-hidden="true">4</span>}
        <Icon name="whatsapp" size={14} class="tb-ico" />
        <span class="tb-item__txt">WhatsApp</span>
      </a>}
    </div>
  </div>
</aside>

{guia && (
  <div class="tbg" role="note" aria-label="Guía del topbar">
    <div class="tbg-inner">
      <p class="tbg__tag"><span aria-hidden="true">🧭</span> Guía · Topbar</p>
      <p class="tbg__intro">
        Barra utilitaria superior (la franja por encima del menú). Cada punto se alimenta de
        <code>src/config/site.ts</code> (fuente única); no se escribe a mano. Esto es lo que va en cada lugar:
      </p>
      <ol class="tbg__list">
        {PUNTOS.map((p) => (
          <li class="tbg__pt">
            <span class="tbg__num">{p.n}</span>
            <div class="tbg__pt-body">
              <p class="tbg__nombre">{p.nombre}</p>
              <p class="tbg__que">{p.que}</p>
              <p class="tbg__dato"><span>Dato</span> <code>{p.dato}</code></p>
            </div>
          </li>
        ))}
      </ol>
      <p class="tbg__edit">
        <span>Edita en</span> <code>src/components/TopBar.astro</code> · <code>src/config/site.ts</code>
      </p>
    </div>
  </div>
)}

<style>
  /* ── Barra real ─────────────────────────────────────────────────────────────
     Sticky en top:0. El Header se pega justo debajo (top:--topbar-height) → juntos
     forman el stack del chrome (--stack-height). Fondo índigo con profundidad y un
     hairline inferior para separarlo del header sin una línea dura. */
  .topbar {
    position: sticky; top: 0; z-index: 501;
    height: var(--topbar-height);
    display: flex; align-items: center;
    color: var(--c-white);
    font-size: var(--text-sm); font-weight: var(--weight-medium);
    background: linear-gradient(100deg, var(--c-primary-dark) 0%, var(--c-primary) 60%, var(--c-primary-light) 140%);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, .14);
  }
  /* En modo guía la barra no se pega, para que la leyenda quede contigua. */
  .topbar.is-guia { position: static; }

  .tb-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--sp-4); width: 100%; max-width: var(--container-max);
    margin-inline: auto; padding-inline: var(--container-px);
  }

  /* Propuesta de valor + chispa de marca (rombo) antes del texto. */
  .tb-promo { display: flex; align-items: center; gap: var(--sp-2); min-width: 0; flex: 1; opacity: .96; margin: 0; }
  .tb-spark {
    flex-shrink: 0; width: 8px; height: 8px; border-radius: 2px;
    background: var(--c-white); transform: rotate(45deg);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, .18);
  }
  .tb-promo__txt { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: .005em; }

  /* Cluster de acciones a la derecha. */
  .tb-actions { display: flex; align-items: center; gap: var(--sp-2); flex-shrink: 0; }
  .tb-item {
    display: inline-flex; align-items: center; gap: .4rem;
    color: var(--c-white); text-decoration: none; white-space: nowrap;
    padding: .25rem .5rem; border-radius: var(--radius-sm);
    transition: background .15s ease, opacity .15s ease;
  }
  .tb-ico { flex-shrink: 0; opacity: .9; }
  .tb-schedule { opacity: .9; cursor: default; }
  .tb-phone:hover { background: rgba(255, 255, 255, .12); }
  .tb-item:focus-visible { outline: 2px solid var(--c-white); outline-offset: 2px; border-radius: var(--radius-sm); }
  /* WhatsApp = acción destacada (píldora translúcida). */
  .tb-wa {
    background: rgba(255, 255, 255, .16); padding: .25rem .8rem;
    border-radius: var(--radius-full); font-weight: var(--weight-semibold);
  }
  .tb-wa:hover { background: rgba(255, 255, 255, .30); }

  /* ── Marcadores (modo guía) ───────────────────────────────────────────────── */
  .tb-mark {
    flex-shrink: 0; display: inline-grid; place-items: center;
    width: 18px; height: 18px; border-radius: var(--radius-full);
    background: var(--c-white); color: var(--c-primary);
    font-family: var(--font-heading); font-weight: var(--weight-bold); font-size: .6875rem;
  }

  /* ── Responsive de la barra ───────────────────────────────────────────────────
     Tablet: se esconde la propuesta para dar aire al contacto.
     Móvil (≤640): el contacto se reparte en DOS acciones de igual peso —llamar y
     WhatsApp— ocupando todo el ancho, con un divisor fino. Adiós a la píldora suelta. */
  @media (max-width: 900px) {
    .tb-promo { display: none; }
    .tb-actions { flex: 1; justify-content: flex-end; }
  }
  @media (max-width: 640px) {
    .tb-schedule { display: none; }
    .tb-inner { gap: 0; }
    .tb-actions { width: 100%; gap: 0; }
    .tb-phone, .tb-wa {
      flex: 1; justify-content: center; min-height: var(--topbar-height);
      background: transparent; border-radius: 0; font-weight: var(--weight-semibold);
    }
    .tb-phone { box-shadow: inset -1px 0 0 rgba(255, 255, 255, .22); }
    .tb-wa:hover, .tb-phone:hover { background: rgba(255, 255, 255, .12); }
  }
  @media (max-width: 1024px) { .tb-item { min-height: 32px; } }
  @media (max-width: 768px) {
    .tb-inner {
      padding-left: max(var(--container-px), env(safe-area-inset-left));
      padding-right: max(var(--container-px), env(safe-area-inset-right));
    }
  }

</style>
