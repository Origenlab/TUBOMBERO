---
// FAQWithContact.astro — FAQ en dos columnas y formulario de cotización por WhatsApp.
import FAQAccordion from '@components/FAQAccordion.astro'
import Icon from '@components/Icon.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { CATEGORIES, CONTACT, SECTORS, SERVICES, WA_MESSAGES, waUrl } from '@config/site'

interface FAQItem { question: string; answer: string }
interface Help { eyebrow: string; title: string; text: string; links: { label: string; href: string; variant?: 'primary' | 'outline' }[] }
interface Props {
  id?: string
  items: FAQItem[]
  waNumber?: string
  eyebrow?: string
  title?: string
  titleAccent?: string
  desc?: string
  body?: string[]
  textareaPlaceholder?: string
  help?: Help
}

const {
  id,
  items,
  waNumber = CONTACT.whatsapp,
  eyebrow = 'Preguntas frecuentes',
  title = 'Preguntas frecuentes',
  titleAccent,
  desc = 'Lo que más nos preguntan — respondemos antes de que cotices.',
  body = [
    'Reunimos las preguntas más frecuentes para que llegues al primer contacto con todo claro.',
    '¿Tu duda no está aquí? Usa el formulario y te respondemos directamente por WhatsApp.',
  ],
  textareaPlaceholder = 'Superficie aproximada, equipo con el que ya cuentas y fecha en que lo necesitas',
  help = {
    eyebrow: '¿No encuentras tu respuesta?',
    title: 'Te orientamos para elegir el equipo contra incendios adecuado.',
    text: 'Revisa las familias de equipo organizadas por necesidad o conoce los servicios de instalación, mantenimiento y capacitación. Si tu caso es particular, completa el formulario de cotización con el detalle de tu instalación.',
    links: [
      { label: 'Catálogo de equipo contra incendios', href: '/#catalogo', variant: 'primary' },
      { label: 'Mantenimiento contra incendios', href: '/servicios' },
    ],
  },
} = Astro.props

const STATES = [
  'Aguascalientes', 'Baja California', 'Baja California Sur', 'Campeche',
  'Chiapas', 'Chihuahua', 'Ciudad de México', 'Coahuila', 'Colima',
  'Durango', 'Estado de México', 'Guanajuato', 'Guerrero', 'Hidalgo',
  'Jalisco', 'Michoacán', 'Morelos', 'Nayarit', 'Nuevo León', 'Oaxaca',
  'Puebla', 'Querétaro', 'Quintana Roo', 'San Luis Potosí', 'Sinaloa',
  'Sonora', 'Tabasco', 'Tamaulipas', 'Tlaxcala', 'Veracruz', 'Yucatán',
  'Zacatecas',
] as const
const waReady = Boolean(waNumber)
// Enlace directo sin JS: mismo número del SSoT con el mensaje de cotización precargado.
const waFallback = waUrl(WA_MESSAGES.cotizar)
---

<section id={id} class="fwc">
  <div class="fwc__inner">
    <SectionHeading layout="duo" eyebrow={eyebrow} title={title} titleAccent={titleAccent} desc={desc} body={body} />

    <div class="fwc__grid">
      <div class="fwc__col-faq">
        <FAQAccordion items={items} title="" bare openFirst />
        <div class="fwc__help">
          <p class="fwc__help-eyebrow">{help.eyebrow}</p>
          <p class="fwc__help-title">{help.title}</p>
          <p class="fwc__help-text">{help.text}</p>
          <div class="fwc__help-actions">
            {help.links.map((link, index) => <a class:list={['fwc__help-btn', (link.variant ?? (index === 0 ? 'primary' : 'outline')) === 'primary' && 'fwc__help-btn--primary']} href={link.href}>{link.label}</a>)}
          </div>
        </div>
      </div>

      <aside id="cotizar" class="fwc__col-form">
        <div class="fwc__card">
          <div class="fwc__card-hd">
            <div class="fwc__wa-icon" aria-hidden="true">
              <Icon name="whatsapp" size={26} />
            </div>
            <div><p class="fwc__eyebrow">Cotización</p><h3 class="fwc__card-title">Cotiza tu equipo contra incendios</h3><p class="fwc__card-sub">Reúne el tipo de instalación, su superficie aproximada y el equipo con el que ya cuentas: con esa información tu cotización será más rápida y precisa.</p></div>
          </div>

          <form id="fwc-form" class="fwc__form">
            <div class="fwc__row"><div class="fwc__field"><label class="fwc__label" for="fwc-name">Nombre completo<span class="fwc__req" aria-hidden="true">*</span></label><input id="fwc-name" name="name" type="text" class="fwc__input" autocomplete="name" required maxlength="100" /></div>
            <div class="fwc__field"><label class="fwc__label" for="fwc-company">Empresa o institución<span class="fwc__req" aria-hidden="true">*</span></label><input id="fwc-company" name="company" type="text" class="fwc__input" autocomplete="organization" required maxlength="120" /></div></div>

            <div class="fwc__row"><div class="fwc__field"><label class="fwc__label" for="fwc-state">Estado<span class="fwc__req" aria-hidden="true">*</span></label><div class="fwc__select-wrap"><select id="fwc-state" name="state" class="fwc__input fwc__select" required><option value="" disabled selected>Selecciona…</option>{STATES.map((state) => <option value={state}>{state}</option>)}</select><span class="fwc__chevron" aria-hidden="true"><Icon name="chevron-down" size={16} /></span></div></div>

            <div class="fwc__field"><label class="fwc__label" for="fwc-sector">Tipo de instalación</label><div class="fwc__select-wrap"><select id="fwc-sector" name="sector" class="fwc__input fwc__select"><option value="" selected>Selecciona…</option>{SECTORS.map((sector) => <option value={sector.label}>{sector.label}</option>)}</select><span class="fwc__chevron" aria-hidden="true"><Icon name="chevron-down" size={16} /></span></div></div></div>

            <div class="fwc__field"><label class="fwc__label" for="fwc-interest">Equipo o servicio de interés<span class="fwc__req" aria-hidden="true">*</span></label><div class="fwc__select-wrap"><select id="fwc-interest" name="interest" class="fwc__input fwc__select" required><option value="" disabled selected>Selecciona una opción…</option><optgroup label="Categorías">{CATEGORIES.map((category) => <option value={category.label}>{category.label}</option>)}</optgroup><optgroup label="Servicios">{SERVICES.map((service) => <option value={service.label}>{service.label}</option>)}</optgroup></select><span class="fwc__chevron" aria-hidden="true"><Icon name="chevron-down" size={16} /></span></div></div>

            <div class="fwc__field fwc__field--grow"><label class="fwc__label" for="fwc-detail">Detalle de tu necesidad</label><textarea id="fwc-detail" name="detail" class="fwc__input fwc__textarea" placeholder={textareaPlaceholder} rows="4" maxlength="600"></textarea></div>

            <button type="submit" class="fwc__btn" disabled={!waReady} aria-disabled={!waReady}><Icon name="whatsapp" size={20} />Cotizar equipo contra incendios por WhatsApp</button>
            {!waReady && <p class="fwc__notice" role="status">Canal de WhatsApp en configuración. Pronto podrás enviar tu solicitud desde aquí.</p>}
            {waFallback && <p class="fwc__fallback">¿No se abre WhatsApp? Escríbenos directo: <a href={waFallback} target="_blank" rel="noopener noreferrer">wa.me/{CONTACT.whatsapp}</a>{CONTACT.phone && <> · {CONTACT.phone}</>}</p>}
            <p class="fwc__privacy">Al pulsar el botón se abre WhatsApp con tu mensaje. No guardamos ningún dato.</p>
          </form>
        </div>
      </aside>
    </div>
  </div>
</section>

<script define:vars={{ waNumber }}>
  const form = document.getElementById('fwc-form')
  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    if (!form.checkValidity() || !waNumber) { form.reportValidity(); return }
    const data = new FormData(form)
    const name = String(data.get('name') || '').trim()
    const company = String(data.get('company') || '').trim()
    const state = String(data.get('state') || '').trim()
    const sector = String(data.get('sector') || '').trim()
    const interest = String(data.get('interest') || '').trim()
    const detail = String(data.get('detail') || '').trim()
    const lines = [
      'Hola, quiero cotizar equipo contra incendios.',
      '',
      `Nombre: ${name}`,
      `Empresa o institución: ${company}`,
      `Estado: ${state}`,
    ]
    if (sector) lines.push(`Tipo de instalación: ${sector}`)
    lines.push(`Equipo o servicio de interés: ${interest}`)
    if (detail) lines.push(`Detalle: ${detail}`)
    const url = `https://${'wa' + '.me'}/${waNumber}?text=${encodeURIComponent(lines.join('\n'))}`
    // Sin 'noopener' en features: con él window.open devuelve null siempre y no se detecta el bloqueo.
    const win = window.open(url, '_blank')
    if (win) win.opener = null
    else window.location.href = url
  })
</script>

<style>
  .fwc { padding: var(--section-py) 0; background: var(--c-surface); }
  .fwc__inner { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-px); }
  .fwc__grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-8); align-items: stretch; }
  .fwc__col-faq { display: flex; flex-direction: column; gap: var(--sp-4); min-width: 0; }
  .fwc__col-faq :global(.faq__inner) { max-width: none; padding-inline: 0; }
  .fwc__col-form { display: flex; min-width: 0; }
  @media (min-width: 1024px) { .fwc__grid { grid-template-columns: minmax(0, 7fr) minmax(20rem, 5fr); gap: var(--sp-10); } }
  .fwc__card { background: var(--c-white); border: 1px solid var(--c-border); border-radius: var(--radius-xl); padding: var(--sp-6); box-shadow: var(--shadow-md); }
    .fwc__card { display: flex; flex-direction: column; width: 100%; }
  .fwc__form { flex: 1; }
  .fwc__row { display: grid; grid-template-columns: 1fr; gap: var(--sp-4); }
  @media (min-width: 560px) { .fwc__row { grid-template-columns: 1fr 1fr; } }
  .fwc__help { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: var(--sp-3); padding: var(--sp-6); border-radius: var(--radius-xl); color: var(--c-white); background: radial-gradient(120% 120% at 100% 0%, rgba(var(--c-primary-rgb), .35) 0%, transparent 55%), linear-gradient(135deg, var(--c-black) 0%, var(--c-ink-3) 100%); box-shadow: var(--shadow-md); }
  .fwc__help-eyebrow { margin: 0; font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: .1em; text-transform: uppercase; color: var(--c-primary-light); }
  .fwc__help-title { margin: 0; font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: var(--leading-snug); }
  .fwc__help-text { margin: 0; font-size: var(--text-sm); line-height: var(--leading-relaxed); color: rgba(255,255,255,.72); }
  .fwc__help-actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-2); }
  .fwc__help-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: .6em 1.1em; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,.28); color: var(--c-white); font-size: var(--text-sm); font-weight: var(--weight-semibold); text-decoration: none; transition: background var(--transition), border-color var(--transition); }
  .fwc__help-btn:hover { border-color: var(--c-white); background: rgba(255,255,255,.08); }
  .fwc__help-btn--primary { background: var(--c-primary); border-color: var(--c-primary); }
  .fwc__help-btn--primary:hover { background: var(--c-primary-dark); border-color: var(--c-primary-dark); }
  .fwc__card-hd { display: flex; align-items: flex-start; gap: var(--sp-3); padding-bottom: var(--sp-5); margin-bottom: var(--sp-5); border-bottom: 1px solid var(--c-border); }
  .fwc__wa-icon { flex-shrink: 0; width: 48px; height: 48px; display: grid; place-items: center; background: var(--c-primary); color: var(--c-white); border-radius: var(--radius-lg); }
  .fwc__eyebrow { margin: 0 0 var(--sp-1); color: var(--c-primary); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: .1em; text-transform: uppercase; }
  .fwc__card-title { margin: 0 0 var(--sp-1); font-family: var(--font-heading); font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: var(--leading-snug); color: var(--c-ink); }
  .fwc__card-sub { margin: 0; font-size: var(--text-sm); line-height: var(--leading-normal); color: var(--c-muted); }
  .fwc__form { display: flex; flex-direction: column; gap: var(--sp-4); }
  .fwc__field { display: flex; flex-direction: column; gap: var(--sp-1); }
  .fwc__label { font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--c-ink); }
  .fwc__req { color: var(--c-primary); margin-left: .15em; }
  .fwc__input { width: 100%; padding: .7em .9em; font-family: var(--font-body); font-size: 16px; color: var(--c-ink); background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-md); }
  .fwc__input:focus { outline: none; border-color: var(--c-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-primary) 18%, transparent); }
  .fwc__select-wrap { position: relative; }
  .fwc__select { appearance: none; padding-right: 2.5em; cursor: pointer; }
  .fwc__chevron { position: absolute; right: .9em; top: 50%; transform: translateY(-50%); display: flex; color: var(--c-muted); pointer-events: none; }
  .fwc__textarea { min-height: 6.75rem; resize: vertical; line-height: var(--leading-normal); }
  .fwc__btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-2); width: 100%; padding: .85em 1.2em; font-family: var(--font-heading); font-size: var(--text-base); font-weight: var(--weight-bold); color: var(--c-white); background: var(--c-primary); border: 0; border-radius: var(--radius-md); cursor: pointer; transition: background var(--transition), transform var(--transition); }
  .fwc__btn:hover:not(:disabled) { background: var(--c-primary-dark); transform: translateY(-1px); }
  .fwc__btn:disabled { cursor: not-allowed; opacity: .55; }
  .fwc__fallback { margin: 0; font-size: var(--text-xs); line-height: var(--leading-normal); text-align: center; color: var(--c-ink-2); }
  .fwc__fallback a { color: var(--c-primary); font-weight: var(--weight-semibold); }
  .fwc__notice, .fwc__privacy { margin: 0; font-size: var(--text-xs); line-height: var(--leading-normal); text-align: center; color: var(--c-muted); }
  .fwc__notice { padding: var(--sp-3); background: var(--c-primary-tint); border-radius: var(--radius-md); }
  .fwc__privacy { margin-top: calc(var(--sp-1) * -1); }
  .fwc__field--grow { flex: 1; }
  .fwc__field--grow .fwc__textarea { flex: 1; }
  @media (prefers-reduced-motion: reduce) { .fwc__btn { transition: none; } .fwc__btn:hover:not(:disabled) { transform: none; } }
</style>
