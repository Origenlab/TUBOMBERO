---
import CategoryCard from '@components/CategoryCard.astro'
import CategoryFeature from '@components/CategoryFeature.astro'
import ArticleCard from '@components/ArticleCard.astro'
import FAQWithContact from '@components/FAQWithContact.astro'
import ProseTable from '@components/ProseTable.astro'
import SectionHeading from '@components/SectionHeading.astro'
import StageGrid from '@components/StageGrid.astro'
import ServiceCard from '@components/ServiceCard.astro'
import SectorCard from '@components/SectorCard.astro'
import SectorDetails from '@components/SectorDetails.astro'
import { CATEGORIES, CATEGORY_FEATURES, SERVICES, SECTORS } from '@config/site'
import { getGuides } from '@lib/guides'
import { img } from '@lib/images'

interface SectionBase { type: string; id: string; eyebrow: string; title: string; accent?: string; desc: string; body: string[] }
interface CategorySection extends SectionBase { type: 'categories' }
interface ServicesSection extends SectionBase { type: 'services' }
interface SectorsSection extends SectionBase { type: 'sectors' }
interface SectorDetailsSection extends SectionBase { type: 'sectorDetails'; items: { slug: string; summary: string; points: string[]; links: { label: string; href: string }[] }[] }
interface StageSection extends SectionBase { type: 'stages'; items: { num: string; title: string; desc: string; links: { label: string; href: string }[] }[] }
interface ProseSection extends SectionBase { type: 'prose' }
interface GuidesSection extends SectionBase { type: 'guides' }
interface Help { eyebrow: string; title: string; text: string; links: { label: string; href: string; variant?: 'primary' | 'outline' }[] }
interface FaqSection extends SectionBase { type: 'faq'; items: { question: string; answer: string }[]; help?: Help }
interface FeatureSection { type: 'feature'; id: string; category: string }
type PageSection = FeatureSection | CategorySection | ServicesSection | SectorsSection | SectorDetailsSection | StageSection | ProseSection | GuidesSection | FaqSection
interface Props { sections: PageSection[]; Content: any }

const { sections, Content } = Astro.props
const guides = await getGuides()
const featureOf = (slug: string) => {
  const feature = CATEGORY_FEATURES.find((item) => item.slug === slug)
  const category = CATEGORIES.find((item) => item.slug === slug)
  if (!feature || !category) throw new Error(`Sin CATEGORY_FEATURES para ${slug}`)
  return { feature, category }
}
---

{sections.map((section, index) => section.type === 'feature' ? (() => {
  const { feature, category } = featureOf(section.category)
  const [imgMain, imgA, imgB] = feature.images
  return (
    <CategoryFeature
      id={section.id}
      headingLevel={2}
      eyebrow={category.tag}
      title={feature.title}
      titleAccent={feature.titleAccent}
      description={feature.description}
      features={[...feature.points]}
      ctaLabel={`Cotizar ${category.cta.toLocaleLowerCase('es-MX')}`}
      ctaHref="#cotizar"
      imgMain={imgMain}
      imgA={imgA}
      imgB={imgB}
      surface={index % 2 === 1}
    />
  )
})() : section.type === 'faq' ? (
  <FAQWithContact
    id={section.id}
    eyebrow={section.eyebrow}
    title={section.title}
    titleAccent={section.accent}
    desc={section.desc}
    body={section.body}
    items={section.items}
    help={section.help}
  />
) : (
  <section id={section.id} class:list={['section', index % 2 === 1 && 'section--surface']}>
    <div class="container">
      <SectionHeading
        id={section.type === 'prose' ? `${section.id}-heading` : undefined}
        eyebrow={section.eyebrow}
        title={section.title}
        titleAccent={section.accent}
        desc={section.desc}
        layout="duo"
        body={section.body}
      />
      {section.type === 'categories' && (
        <div class="grid-4 category-grid">
          {CATEGORIES.map((category, categoryIndex) => (
            <CategoryCard
              label={category.label}
              href={`/productos/${category.slug}`}
              image={category.image}
              imageAlt={category.imageAlt}
              imagePosition={category.imagePosition}
              badge={category.tag}
              blurb={category.description}
              subcategories={category.subcategories}
              ctaLabel={category.cta}
              index={categoryIndex}
            />
          ))}
        </div>
      )}
      {section.type === 'services' && (
        <div class="grid-4">
          {SERVICES.map((service) => (
            <ServiceCard
              id={service.id}
              title={service.label}
              description={service.desc}
              image={service.image}
              imageAlt={service.imageAlt}
              ctaLabel={service.cta}
              href="#cotizar"
            />
          ))}
        </div>
      )}
      {section.type === 'sectors' && <div class="grid-4 sector-grid">{SECTORS.map((sector, sectorIndex) => <SectorCard label={sector.label} icon={sector.icon} num={`0${sectorIndex + 1}`} href={`#sector-${sector.slug}`} />)}</div>}
      {section.type === 'sectorDetails' && <SectorDetails items={section.items} />}
      {section.type === 'stages' && <StageGrid items={section.items} />}
      {section.type === 'prose' && (
        <ProseTable labelId={`${section.id}-heading`}><Content /></ProseTable>
      )}
      {section.type === 'guides' && (
        <div class="grid-4">
          {guides.map((guide, guideIndex) => guide && <ArticleCard title={guide.data.title} excerpt={guide.data.excerpt} href={`/guias/${guide.id}`} cta={`Guía de ${guide.data.keyword}`} num={`0${guideIndex + 1}`} image={guide.data.image ? img(guide.data.image) : undefined} imageAlt={guide.data.imageAlt} />)}
        </div>
      )}
    </div>
  </section>
))}
