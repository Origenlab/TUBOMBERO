---
interface Props {
  title: string;
  description: string;
  tag: string;
  image: string;
  imageAlt: string;
  index: number;
}
const { title, description, tag, image, imageAlt, index } = Astro.props;
---

<article class="category-card reveal" style={`animation-delay: ${index * 80}ms`}>
  <img src={image} alt={imageAlt} width="1280" height="960" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
  <div class="category-card__body">
    <p>{tag}</p>
    <h3>{title}</h3>
    <span>{description}</span>
    <a href="#cotizar" aria-label={`Solicitar información sobre ${title}`}>Conocer opciones <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .category-card { background: var(--surface); border: 1px solid var(--line); overflow: hidden; transition: background .2s ease, transform .2s ease; }
  .category-card:hover { background: var(--soft-blue); transform: translateY(-2px); }
  .category-card img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .category-card__body { padding: 1.25rem 1.3rem 1.45rem; }
  .category-card p { color: var(--red); font-size: .68rem; font-weight: 800; letter-spacing: .11em; margin: 0 0 .7rem; text-transform: uppercase; }
  .category-card h3 { font-family: var(--display); font-size: 1.6rem; letter-spacing: -.045em; line-height: 1; margin: 0 0 .7rem; }
  .category-card span { color: var(--muted); display: block; font-size: .88rem; line-height: 1.5; }
  .category-card a { display: inline-flex; font-size: .83rem; font-weight: 700; gap: .55rem; margin-top: 1.3rem; }
  .category-card a span { color: var(--red); font-size: 1rem; line-height: 1; }
</style>
