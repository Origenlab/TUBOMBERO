---
interface Subcategory { label: string; href: string; }
interface Props { label: string; href: string; image: string; imageAlt: string; badge?: string; blurb: string; subcategories?: readonly Subcategory[]; ctaLabel?: string; index?: number; }
const { label, href, image, imageAlt, badge, blurb, subcategories = [], ctaLabel = 'Conocer opciones', index = 0 } = Astro.props;
---
<article class="category-card"><a class="category-card__media" href={href}><img src={image} alt={imageAlt} width="640" height="400" loading={index < 3 ? 'lazy' : 'lazy'} style={`object-position: ${index % 3 === 0 ? 'center' : index % 3 === 1 ? '45% center' : '70% center'}`} />{badge && <span>{badge}</span>}</a><div class="category-card__body"><h3><a href={href}>{label}</a></h3><p>{blurb}</p>{subcategories.length > 0 && <ul>{subcategories.map((sub) => <li><a href={sub.href}>{sub.label}</a></li>)}</ul>}<a class="category-card__cta" href={href}>{ctaLabel}<span aria-hidden="true">→</span></a></div></article>
<style>
  .category-card { display: flex; flex-direction: column; overflow: hidden; border: var(--border); border-radius: var(--radius-lg); background: var(--c-white); box-shadow: var(--shadow-sm); }
  .category-card__media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--c-surface); }
  .category-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .category-card__media span { position: absolute; top: var(--sp-3); left: var(--sp-3); padding: .3rem .55rem; border-radius: var(--radius-sm); background: var(--c-primary); color: var(--c-white); font-size: var(--text-xs); font-weight: var(--weight-bold); }
  .category-card__body { display: flex; flex: 1; flex-direction: column; gap: var(--sp-3); padding: var(--sp-5); }
  .category-card h3 { margin: 0; font-family: var(--font-heading); font-size: var(--text-lg); line-height: var(--leading-snug); }
  .category-card h3 a { text-decoration: none; }
  .category-card p { margin: 0; color: var(--c-ink-2); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .category-card ul { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin: auto 0 0; padding: 0; list-style: none; }
  .category-card li a { display: inline-block; padding: .3rem .55rem; border: var(--border); border-radius: var(--radius-full); color: var(--c-ink-2); font-size: var(--text-xs); text-decoration: none; }
  .category-card__cta { display: inline-flex; align-items: center; gap: var(--sp-2); color: var(--c-primary); font-size: var(--text-sm); font-weight: var(--weight-bold); text-decoration: none; }
</style>
