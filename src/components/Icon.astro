---
// Icon — referencia un símbolo del sprite estático /icons.svg (cacheable entre páginas).
// Sin JavaScript: el SVG se entrega en el HTML y el navegador resuelve <use> por URL.
interface Props { name: string; size?: number | string; class?: string }
const { name, size = 18, class: className } = Astro.props;
---
<svg width={size} height={size} class={className} aria-hidden="true" focusable="false"><use href={`/icons.svg#i-${name}`} /></svg>
