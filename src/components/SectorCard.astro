---
import { getEntry } from 'astro:content';
import CategoryCard from './CategoryCard.astro';
import type { Sector } from '@config/site';
interface Props { sector: Sector; href: string }
const { sector, href } = Astro.props;
const page = await getEntry('paginas', 'sectores');
const details = page?.data.sections.find((section) => section.type === 'sectorDetails');
const description = details?.type === 'sectorDetails' ? details.items.find((item) => item.slug === sector.slug)?.summary : undefined;
---
<CategoryCard label={sector.label} href={href} image={sector.image} imageAlt={sector.imageAlt} blurb={description} ctaLabel={`Ver ${sector.label.toLocaleLowerCase('es-MX')}`} />
