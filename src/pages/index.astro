---
import CategoryCard from '@components/CategoryCard.astro';
import CategoryFeature from '@components/CategoryFeature.astro';
import CTABanner from '@components/CTABanner.astro';
import Hero from '@components/Hero.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import SectionHeading from '@components/SectionHeading.astro';
import SectionMenu from '@components/SectionMenu.astro';
import ServiceCard from '@components/ServiceCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { CATEGORIES, PROCESS, SERVICES, SITE } from '@config/site';

const menuItems = [
  { label: 'Catálogo', href: '#catalogo', sub: 'Catálogo por necesidad' },
  { label: 'Sectores', href: '#sectores', sub: 'Soluciones por sector' },
  { label: 'Servicios', href: '#servicios', sub: 'Lo que ofreces · Ver servicios' },
  { label: 'Guías', href: '#guias', sub: 'Guías técnicas' },
];
const steps = PROCESS.map(([title, desc], index) => ({ num: `0${index + 1}`, title, desc }));
---

<PageLayout title="Equipos y soluciones contra incendio | Tu Bombero" description="Equipo contra incendio, extintores y sistemas para organizaciones, brigadas y proyectos que buscan orientar su compra en toda la República Mexicana." pageType="home">
  <Hero
    badge="Equipamiento y soluciones"
    title="Equipos y soluciones"
    accent=" contra incendio"
    after="para operar con mayor preparación."
    coverage="Cobertura · Cobertura comercial prevista para toda la República Mexicana · Toda la República Mexicana"
    subtitle="Explora un catálogo pensado para organizaciones, brigadas y proyectos que buscan orientar su compra en todo México."
    descRight={[
      SITE.description,
      'Las ubicaciones, horarios y canales de atención se integrarán al confirmar los datos comerciales.',
    ]}
    image={{ src: '/images/home/hero-inspeccion-equipo-contra-incendio.avif', alt: 'Técnico revisando un gabinete y red contra incendio' }}
    ctas={[{ text: 'Solicitar información', href: '/contacto' }, { text: 'Explorar catálogo', href: '#catalogo', variant: 'outline' }]}
  />

  <SectionMenu items={menuItems} cta={{ label: 'Cotizar', href: '/contacto', sub: 'Solicitar información' }} />

  <section id="catalogo" class="section section--surface">
    <div class="container">
      <SectionHeading
        eyebrow="Catálogo"
        title="Encuentra el equipo según el punto que necesitas atender."
        desc="La primera versión organiza el catálogo en seis familias para que la navegación sea clara desde el inicio. Las fichas técnicas y referencias reales se incorporarán a partir del inventario confirmado."
        layout="duo"
        body={[SITE.description, 'Canal de contacto pendiente']}
      />
      <div class="category-grid">
        {CATEGORIES.map((category, index) => <CategoryCard label={category.label} href={`/productos/${category.slug}`} image={category.image} imageAlt={category.imageAlt} badge={category.tag} blurb={category.description} index={index} />)}
      </div>
    </div>
  </section>

  <section id="sectores" class="section sectors">
    <div class="container sectors__grid">
      <div><p class="eyebrow">Soluciones por sector</p><h2 class="section-title">Un punto de partida para cada operación.</h2></div>
      <div><p class="section-copy">El catálogo crecerá con rutas específicas para cada tipo de instalación, haciendo más fácil ubicar el equipo y servicio que se requiere.</p><ul>{['Industria y manufactura', 'Construcción e infraestructura', 'Comercio y oficinas', 'Hospitalidad y salud', 'Protección Civil y bomberos', 'Almacenes y logística'].map((sector, index) => <li><span>0{index + 1}</span>{sector}<b aria-hidden="true">↗</b></li>)}</ul></div>
    </div>
  </section>

  <section id="servicios" class="section">
    <div class="container">
      <SectionHeading eyebrow="Servicios" title="Acompañamiento antes, durante y después de la selección." desc="Las líneas de servicio se presentan como un mapa comercial. El alcance concreto de cada una se publicará al confirmar las capacidades operativas y comerciales de Tu Bombero." layout="duo" body={[SERVICES[0].desc, SERVICES[3].desc]} />
      <a class="service-link" href="#servicios">Ver servicios</a>
      <div class="service-grid">{SERVICES.map((service) => <ServiceCard title={service.label} description={service.desc} href="/servicios" />)}</div>
    </div>
  </section>

  <CategoryFeature
    eyebrow="Equipo para bomberos y brigadas"
    title="Preparación visible"
    titleAccent="desde el primer vistazo."
    description="Protección personal, equipo de respiración, accesorios y herramientas de apoyo estarán agrupados en una sección dedicada para facilitar la consulta técnica y comercial."
    features={[{ label: 'Protección personal' }, { label: 'Rescate y accesorios' }, { label: 'Equipo para bomberos y brigadas' }]}
    imgMain={{ src: '/images/home/epp-y-rescate.avif', alt: 'Equipo de protección personal y rescate para bomberos' }}
    imgA={{ src: '/images/home/extintores-y-emergencia.avif', alt: 'Extintores y elementos de emergencia' }}
    imgB={{ src: '/images/home/hero-inspeccion-equipo-contra-incendio.avif', alt: 'Inspección de equipo contra incendio' }}
    ctaLabel="Solicitar orientación"
    ctaHref="/contacto"
    surface
  />

  <section id="guias" class="section section--surface">
    <div class="container">
      <SectionHeading eyebrow="Guías técnicas" title="Contenido que ayuda a empezar la conversación correcta." desc="El centro de recursos se construirá con artículos revisados antes de su publicación. Desde ahora, el sitio reserva sus rutas principales para no depender únicamente de un catálogo." />
      <div class="guide-grid">
        {['Cómo identificar una familia de equipo contra incendio', 'Qué información preparar antes de solicitar una cotización', 'Cómo organizar la consulta de una necesidad de protección'].map((title, index) => <article><span>0{index + 1}</span><h3>{title}</h3><a href="/contacto">Solicitar información <b aria-hidden="true">→</b></a></article>)}
      </div>
    </div>
  </section>

  <ProcessSteps eyebrow="Ruta de atención" title="De una necesidad a" titleAccent="una conversación clara." desc="Un camino sencillo para ubicar el equipo y servicio que se requiere." steps={steps} />

  <CTABanner id="cotizar" heading="Cuéntanos qué necesitas proteger." desc="Estamos preparando los canales de atención. Cuando compartas el teléfono, WhatsApp o correo comercial, esta sección quedará conectada para iniciar cada solicitud con contexto. Para publicar el acceso de cotización necesitamos confirmar un dato real de contacto." btns={[{ label: 'Solicitar información', href: '/contacto', primary: true }]} badge="Canal de contacto pendiente" variant="dark" />
</PageLayout>

<style>
  .category-grid, .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); }
  .section--surface, .sectors { background: var(--c-surface); }
  .sectors { border-block: var(--border); }
  .sectors__grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem, 7vw, 6rem); }
  .sectors ul { margin: var(--sp-6) 0 0; padding: 0; border-top: var(--border); list-style: none; }
  .sectors li { display: grid; grid-template-columns: 2rem 1fr auto; gap: var(--sp-3); align-items: center; padding: var(--sp-4) 0; border-bottom: var(--border); font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--weight-semibold); }
  .sectors li span { color: var(--c-primary); font-size: var(--text-xs); }
  .sectors li b { color: var(--c-primary); }
  .guide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); }
  .guide-grid article { display: flex; flex-direction: column; min-height: 14rem; padding: var(--sp-5); border: var(--border); border-radius: var(--radius-lg); background: var(--c-white); box-shadow: var(--shadow-sm); }
  .guide-grid span { color: var(--c-primary); font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: var(--weight-bold); }
  .guide-grid h3 { margin: var(--sp-5) 0 auto; font-family: var(--font-heading); font-size: var(--text-lg); line-height: var(--leading-snug); }
   .guide-grid a { color: var(--c-primary); font-size: var(--text-sm); font-weight: var(--weight-bold); text-decoration: none; }
   .service-link { display: inline-flex; margin: 0 0 var(--sp-5); color: var(--c-primary); font-size: var(--text-sm); font-weight: var(--weight-bold); text-decoration: none; }
  @media (max-width: 900px) { .category-grid, .service-grid { grid-template-columns: repeat(2, 1fr); } .sectors__grid { grid-template-columns: 1fr; } .guide-grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .category-grid, .service-grid { grid-template-columns: 1fr; } }
</style>
