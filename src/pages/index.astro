---
import CategoryCard from '@components/CategoryCard.astro';
import CategoryFeature from '@components/CategoryFeature.astro';
import CTABanner from '@components/CTABanner.astro';
import Hero from '@components/Hero.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import SectionHeading from '@components/SectionHeading.astro';
import SectionMenu from '@components/SectionMenu.astro';
import ServiceCard from '@components/ServiceCard.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { CATEGORIES, PROCESS, SERVICES, SECTORS } from '@config/site';

const menuItems = [
  { label: 'Catálogo', href: '#catalogo', sub: 'Catálogo por necesidad' },
  { label: 'Sectores', href: '#sectores', sub: 'Soluciones por sector' },
  { label: 'Servicios', href: '#servicios', sub: 'Lo que ofreces · Ver servicios' },
  { label: 'Guías', href: '#guias', sub: 'Guías técnicas' },
];
const steps = PROCESS.map(([title, desc], index) => ({ num: `0${index + 1}`, title, desc }));
---

<PageLayout title="Equipos y soluciones contra incendio | Tu Bombero" description="Equipo contra incendio, extintores y sistemas para organizaciones, brigadas y proyectos que buscan orientar su compra en toda la República Mexicana." pageType="home">
  <Hero
    badge="Equipamiento y soluciones"
    title="Equipos y soluciones"
    accent=" contra incendio"
    after="para operar con mayor preparación."
    coverage="Cobertura comercial prevista para toda la República Mexicana."
    subtitle="Explora un catálogo pensado para organizaciones, brigadas y proyectos que buscan orientar su compra en todo México."
    descRight={[
      'En Tu Bombero reunimos en un solo catálogo el equipo contra incendio que una organización necesita para proteger a su gente, sus instalaciones y su operación: extintores y equipo de respuesta inicial, componentes para sistemas contra incendio —redes hidráulicas, mangueras, hidrantes, válvulas y gabinetes—, detección y alarma, señalización y evacuación, y equipo para bomberos y brigadas. Cada familia está organizada por necesidad para que encuentres más rápido lo que tu instalación requiere.',
      'El catálogo está pensado para industria y manufactura, construcción, comercio y oficinas, hospitalidad y salud, almacenes y logística, y cuerpos de Protección Civil en toda la República Mexicana. Nuestras líneas de servicio —asesoría técnica, instalación de sistemas, mantenimiento y capacitación— buscan acompañarte antes, durante y después de la compra, para que cada decisión sobre equipo contra incendio se tome con criterio técnico y no solo por precio.',
    ]}
    ctas={[{ text: 'Solicitar información', href: '/contacto' }, { text: 'Explorar catálogo', href: '#catalogo', variant: 'outline' }]}
  />

  <SectionMenu items={menuItems} cta={{ label: 'Cotizar', href: '/contacto', sub: 'Solicitar información' }} />

  <section id="catalogo" class="section section--surface">
    <div class="container">
      <SectionHeading
        eyebrow="Catálogo"
        title="Encuentra el equipo según el punto que necesitas atender."
        desc="La primera versión organiza el catálogo en ocho familias para que la navegación sea clara desde el inicio. Las fichas técnicas y referencias reales se incorporarán a partir del inventario confirmado."
        layout="duo"
      />
      <div class="grid-4 category-grid">
        {CATEGORIES.map((category, index) => <CategoryCard label={category.label} href={`/productos/${category.slug}`} image={category.image} imageAlt={category.imageAlt} imagePosition={category.imagePosition} badge={category.tag} blurb={category.description} subcategories={category.subcategories} index={index} />)}
      </div>
    </div>
  </section>

  <section id="sectores" class="section sectors">
    <div class="container sectors__grid">
      <div><p class="eyebrow">Soluciones por sector</p><h2 class="section-title">Un punto de partida para cada operación.</h2></div>
      <div><p class="section-copy">El catálogo crecerá con rutas específicas para cada tipo de instalación, haciendo más fácil ubicar el equipo y servicio que se requiere.</p><div class="grid-4 sector-grid">{SECTORS.map((sector, index) => <article class="sector-card"><span class="sector-card__icon" aria-hidden="true">{sector.icon === 'cross' ? '✚' : sector.icon === 'flame' ? '♨' : sector.icon === 'shield' ? '⬟' : sector.icon === 'briefcase' ? '▣' : sector.icon === 'school' ? '⌂' : '▤'}</span><span class="sector-card__num">0{index + 1}</span><span class="sector-card__label">{sector.label}</span><b aria-hidden="true">↗</b></article>)}</div></div>
    </div>
  </section>

  <section id="servicios" class="section">
    <div class="container">
      <SectionHeading eyebrow="Servicios" title="Acompañamiento antes, durante y después de la selección." desc="Las líneas de servicio se presentan como un mapa comercial. El alcance concreto de cada una se publicará al confirmar las capacidades operativas y comerciales de Tu Bombero." layout="duo" />
      <a class="service-link" href="#servicios">Ver servicios</a>
      <div class="grid-4 service-grid">{SERVICES.map((service) => <ServiceCard title={service.label} description={service.desc} href="/servicios" />)}</div>
    </div>
  </section>

  <CategoryFeature
    eyebrow="Equipo para bomberos y brigadas"
    title="Preparación visible"
    titleAccent="desde el primer vistazo."
    description="Protección personal, equipo de respiración, accesorios y herramientas de apoyo estarán agrupados en una sección dedicada para facilitar la consulta técnica y comercial."
    features={[{ label: 'Protección personal', desc: 'Equipo para respuesta especializada.' }, { label: 'Rescate y accesorios', desc: 'Apoyo operativo y preparación.' }, { label: 'Equipo para bomberos y brigadas', desc: 'Consulta técnica y comercial.' }]}
    imgMain={{ src: '/images/home/epp-y-rescate.avif', alt: 'Equipo de protección personal y rescate para bomberos' }}
    imgA={{ src: '/images/home/extintores-y-emergencia.avif', alt: 'Extintores y elementos de emergencia' }}
    imgB={{ src: '/images/home/hero-inspeccion-equipo-contra-incendio.avif', alt: 'Inspección de equipo contra incendio' }}
    ctaLabel="Solicitar orientación"
    ctaHref="/contacto"
    surface
  />

  <section id="guias" class="section section--surface">
    <div class="container">
      <SectionHeading eyebrow="Guías técnicas" title="Contenido que ayuda a empezar la conversación correcta." desc="El centro de recursos se construirá con artículos revisados antes de su publicación. Desde ahora, el sitio reserva sus rutas principales para no depender únicamente de un catálogo." />
      <div class="grid-4 guide-grid">
        {['Cómo identificar una familia de equipo contra incendio', 'Qué información preparar antes de solicitar una cotización', 'Cómo organizar la consulta de una necesidad de protección', 'Cómo elegir el tipo de extintor según el riesgo de tu instalación'].map((title, index) => <article><span>0{index + 1}</span><h3>{title}</h3><a href="/contacto">Solicitar información <b aria-hidden="true">→</b></a></article>)}
      </div>
    </div>
  </section>

  <ProcessSteps eyebrow="Ruta de atención" title="De una necesidad a" titleAccent="una conversación clara." desc="Un camino sencillo para ubicar el equipo y servicio que se requiere." steps={steps} />

  <CTABanner id="cotizar" heading="Cuéntanos qué necesitas proteger." desc="Estamos preparando los canales de atención. Cuando compartas el teléfono, WhatsApp o correo comercial, esta sección quedará conectada para iniciar cada solicitud con contexto. Para publicar el acceso de cotización necesitamos confirmar un dato real de contacto." btns={[{ label: 'Solicitar información', href: '/contacto', primary: true }]} badge="Canal de contacto pendiente · Canales de atención en configuración" variant="dark" />
</PageLayout>

<style>
  .section--surface, .sectors { background: var(--c-surface); }
  .sectors { border-block: var(--border); }
  .sectors__grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem, 7vw, 6rem); }
  .sector-grid { margin-top: var(--sp-6); }
  .sector-card { display: grid; grid-template-columns: auto 1fr auto; gap: var(--sp-3); align-items: center; min-height: 7rem; padding: var(--sp-4); border: var(--border); border-radius: var(--radius-lg); background: var(--c-white); color: var(--c-ink); text-decoration: none; box-shadow: var(--shadow-sm); }
  .sector-card:hover { color: var(--c-primary-dark); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .sector-card__icon { grid-row: span 2; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: var(--radius-md); background: var(--c-primary); color: var(--c-white); font-size: var(--text-xl); }
  .sector-card__num { color: var(--c-primary); font-size: var(--text-xs); font-weight: var(--weight-bold); }
  .sector-card__label { grid-column: 2 / -1; font-family: var(--font-heading); font-size: var(--text-base); font-weight: var(--weight-semibold); line-height: var(--leading-snug); }
  .sector-card b { color: var(--c-primary); }
  .guide-grid { gap: var(--sp-5); }
  .guide-grid article { display: flex; flex-direction: column; min-height: 14rem; padding: var(--sp-5); border: var(--border); border-radius: var(--radius-lg); background: var(--c-white); box-shadow: var(--shadow-sm); }
  .guide-grid span { color: var(--c-primary); font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: var(--weight-bold); }
  .guide-grid h3 { margin: var(--sp-5) 0 auto; font-family: var(--font-heading); font-size: var(--text-lg); line-height: var(--leading-snug); }
   .guide-grid a { color: var(--c-primary); font-size: var(--text-sm); font-weight: var(--weight-bold); text-decoration: none; }
   .service-link { display: inline-flex; margin: 0 0 var(--sp-5); color: var(--c-primary); font-size: var(--text-sm); font-weight: var(--weight-bold); text-decoration: none; }
  @media (max-width: 900px) { .sectors__grid { grid-template-columns: 1fr; } }
</style>
