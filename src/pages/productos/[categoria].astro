---
import L2Page from '@components/L2Page.astro';
import { CATEGORIES } from '@config/site';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { categoria: category.slug } }));
}
const { categoria } = Astro.params;
---
<L2Page slug={`productos/${categoria}`} parent={{ label: 'Productos', href: '/productos' }} />
