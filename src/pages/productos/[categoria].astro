---
import PageLayout from '@layouts/PageLayout.astro';
import { CATEGORIES } from '@config/site';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { categoria: category.slug }, props: { category } }));
}
const { category } = Astro.props;
---
<PageLayout title={category.seoTitle} description={category.seoDescription} pageType="category" noindex breadcrumbs={[{ label: 'Productos', href: '/productos' }, { label: category.label }]}>
  <section class="category-hero"><div class="container"><p class="eyebrow">Categoría de productos</p><h1>{category.label}</h1><p>{category.seoDescription}</p><span class="status">Fichas técnicas en preparación</span></div></section>
  <section class="section"><div class="container empty-state"><h2>Estamos preparando esta categoría</h2><p>Las fichas técnicas y referencias reales se incorporarán a partir del inventario confirmado.</p><ul class="subcategory-list" aria-label={`Subcategorías de ${category.label}`}>{category.subcategories.map((subcategory) => <li>{subcategory}</li>)}</ul><a href="/contacto">{`Cotizar ${category.cta.toLocaleLowerCase("es-MX")}`} <span aria-hidden="true">→</span></a></div></section>
</PageLayout>
<style>
  .category-hero { padding-block: clamp(4rem, 9vw, 7rem); background: var(--c-ink); color: var(--c-white); }
  .category-hero h1 { margin: 0; font-family: var(--font-heading); font-size: clamp(2.5rem, 6vw, 5rem); line-height: var(--leading-tight); }
  .category-hero p:not(.eyebrow) { max-width: 60ch; color: rgb(255 255 255 / .74); font-size: var(--text-lg); line-height: var(--leading-relaxed); }
  .category-hero .eyebrow { color: var(--c-primary-light); }
  .status { display: inline-block; margin-top: var(--sp-3); padding: .4rem .7rem; border: 1px solid rgb(255 255 255 / .2); border-radius: var(--radius-full); color: rgb(255 255 255 / .8); font-size: var(--text-sm); }
  .empty-state { padding-block: var(--sp-8); }
  .empty-state h2 { margin: 0 0 var(--sp-3); font-family: var(--font-heading); font-size: clamp(1.75rem, 4vw, 2.75rem); }
  .empty-state p { color: var(--c-ink-2); font-size: var(--text-lg); }
  .empty-state a { display: inline-flex; gap: var(--sp-2); margin-top: var(--sp-4); color: var(--c-primary); font-weight: var(--weight-bold); text-decoration: none; }
  .subcategory-list { display: grid; grid-template-columns: repeat(2, minmax(0, max-content)); gap: var(--sp-2); margin: var(--sp-5) 0 0; padding: 0; list-style: none; }
  .subcategory-list li { padding: .45em .7em; border: 1px solid var(--c-border); border-radius: var(--radius-sm); background: var(--c-surface); color: var(--c-ink-2); font-size: var(--text-sm); }
</style>
