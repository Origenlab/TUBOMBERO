---
import { getCollection, getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import ArticleCard from '@components/ArticleCard.astro';
import CategoryCard from '@components/CategoryCard.astro';
import FAQWithContact from '@components/FAQWithContact.astro';
import ProseTable from '@components/ProseTable.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { CATEGORIES } from '@config/site';
import { img } from '@lib/images';

export async function getStaticPaths() {
  const guides = await getCollection('guias');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide: pathGuide } = Astro.props;
const guide = pathGuide ?? await getEntry('guias', Astro.params.slug!);
if (!guide) throw new Error(`No se encontró la guía ${Astro.params.slug}`);
const { Content, headings } = await render(guide);
const { title, seoTitle, description, keyword, updated, excerpt, related, faq, noindex, image, imageAlt, category } = guide.data;
const relatedGuides = (await getCollection('guias')).filter((entry) => related.includes(entry.id));
const categoryData = category ? CATEGORIES.find((item) => item.slug === category) : undefined;
const dateLabel = updated.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const minutes = Math.max(1, Math.ceil((guide.body ?? '').split(/\s+/).filter(Boolean).length / 200));
const imageData = image ? img(image) : undefined;
---

<PageLayout
  title={seoTitle}
  description={description}
  image={imageData?.src}
  pageType="techArticle"
  noindex={noindex}
  breadcrumbs={[{ label: 'Guías', href: '/guias' }, { label: title }]}
  schemaData={{ techArticle: { headline: title, description, path: `/guias/${guide.id}`, datePublished: updated.toISOString(), dateModified: updated.toISOString(), image: imageData?.src } }}
>
  <section class="guide-hero">
    <div class="container">
      <p class="eyebrow">Guía técnica</p>
      <h1>{title}</h1>
      <div class="guide-hero__meta"><span>Actualizada el {dateLabel}</span><span aria-hidden="true">·</span><span>{minutes} min de lectura</span></div>
      <p class="guide-hero__excerpt">{excerpt}</p>
      {imageData && <Picture src={imageData} alt={imageAlt ?? title} width={1200} height={675} widths={[640, 1200]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="avif" loading="eager" fetchpriority="high" decoding="async" class="guide-hero__image" />}
    </div>
  </section>

  <section class="guide-content section">
    <div class="container guide-content__grid">
      <nav class="guide-toc" aria-label="Contenido de la guía">
        <p class="guide-toc__label">Contenido</p>
        <ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </nav>
      <div class="prose"><ProseTable ariaLabel="Tabla de la guía"><Content /></ProseTable></div>
    </div>
  </section>

  <section class="section guide-related">
    <div class="container">
      <SectionHeading eyebrow="También te puede servir" title="Guías relacionadas" layout="simple" align="left" />
      <div class="grid-4">
        {categoryData && <CategoryCard label={categoryData.label} href={`/productos/${categoryData.slug}`} image={categoryData.image} imageAlt={categoryData.imageAlt} imagePosition={categoryData.imagePosition} badge={categoryData.tag} blurb={categoryData.description} subcategories={categoryData.subcategories} ctaLabel={categoryData.cta} />}
        {relatedGuides.map((relatedGuide) => <ArticleCard title={relatedGuide.data.title} excerpt={relatedGuide.data.excerpt} href={`/guias/${relatedGuide.id}`} cta={`Guía de ${relatedGuide.data.keyword}`} />)}
      </div>
    </div>
  </section>

  <FAQWithContact
    id="preguntas-frecuentes"
    eyebrow="Preguntas frecuentes"
    title="Preguntas frecuentes sobre"
    titleAccent={`${keyword}.`}
    desc={`Respuestas breves sobre ${keyword}.`}
    body={[]}
    items={faq}
    help={{ eyebrow: '¿Buscas material?', title: 'Consulta el catálogo de material contra incendios.', text: 'Extintores, red contra incendios, detección y alarma, señalización y equipo para brigadas organizados por familia.', links: [{ label: 'Catálogo de material contra incendios', href: '/productos', variant: 'primary' }, { label: 'Guías de protección contra incendios', href: '/guias', variant: 'outline' }] }}
  />
</PageLayout>

<style>
  .guide-hero { padding-block: clamp(2.5rem, 6vw, 4.5rem); background: var(--c-surface); border-bottom: 1px solid var(--c-border); }
  .guide-hero h1 { max-width: 18ch; margin: 0; font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 4.5rem); line-height: var(--leading-tight); letter-spacing: -.03em; }
  .guide-hero__meta { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-4); color: var(--c-muted); font-size: var(--text-sm); }
  .guide-hero__excerpt { max-width: 72ch; margin: var(--sp-5) 0 0; color: var(--c-ink-2); font-size: var(--text-lg); line-height: var(--leading-relaxed); }
  .guide-hero__image { display: block; width: 100%; max-width: 1200px; aspect-ratio: 16 / 9; margin-top: var(--sp-6); object-fit: cover; border-radius: var(--radius-lg); }
  .guide-content__grid { display: grid; grid-template-columns: minmax(12rem, 16rem) minmax(0, 72ch); gap: clamp(var(--sp-8), 5vw, var(--sp-12)); align-items: start; }
  .guide-toc { position: sticky; top: calc(var(--stack-height) + var(--sp-4)); }
  .guide-toc__label { margin: 0 0 var(--sp-3); color: var(--c-primary); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: .08em; text-transform: uppercase; }
  .guide-toc ol { display: grid; gap: var(--sp-2); margin: 0; padding-left: 1.25rem; color: var(--c-muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
  .guide-toc a { color: inherit; text-decoration: none; }
  .guide-toc a:hover { color: var(--c-primary); }
  .prose { max-width: 72ch; min-width: 0; }
  .prose :global(.prose-table) { max-width: 100%; }
  .prose :global(h2), .prose :global(h3) { font-family: var(--font-heading); scroll-margin-top: calc(var(--stack-height) + var(--sp-4)); }
  .prose :global(h2) { margin-top: var(--sp-10); color: var(--c-ink); font-size: var(--text-2xl); line-height: var(--leading-tight); }
  .prose :global(h3) { margin-top: var(--sp-6); color: var(--c-ink); font-size: var(--text-xl); }
  .prose :global(p), .prose :global(li) { color: var(--c-ink-2); line-height: var(--leading-relaxed); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; }
  .prose :global(a) { color: var(--c-primary-dark); text-decoration: underline; text-underline-offset: .12em; }
  .guide-related { background: var(--c-surface); }
  @media (max-width: 1023px) { .guide-content__grid { grid-template-columns: 1fr; gap: var(--sp-6); } .guide-toc { position: static; } }
</style>
