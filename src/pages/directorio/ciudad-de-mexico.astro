---
import StateDirectoryDetail from '@components/StateDirectoryDetail.astro';
import { DIRECTORY_STATES } from '@config/site';

const state = DIRECTORY_STATES.find((item) => item.slug === 'ciudad-de-mexico');
if (!state) throw new Error('No se encontró la ficha de directorio para Ciudad de México.');
---

<StateDirectoryDetail state={state} />
