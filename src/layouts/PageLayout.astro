---
{/* PageLayout — chrome estándar: Header + Breadcrumbs + <slot/> + Footer + WhatsAppFloat. Extiende BaseLayout | Origen: BOMBERO (Base→Page limpio) */}

// ============================================================================
// PageLayout.astro — CHROME ESTÁNDAR del sitio.
//
// Extiende BaseLayout y añade el "marco" que comparten casi todas las páginas:
// Header, Breadcrumbs (opcional), <main>, Footer y el botón flotante de
// WhatsApp. Las páginas de tipo (ProductLayout, ServiceLayout, ArticleLayout,
// directorio) extienden ESTE layout, no BaseLayout directamente.
//
// Componentes: se referencian con el alias @components/* (los crea el agente de
// componentes; aquí solo se invocan por nombre). Mapea @components en tsconfig.json:
//   "paths": { "@components/*": ["src/components/*"] }
//
// CONTRATO: mismas props que BaseLayout + `breadcrumbs?`.
//   breadcrumbs = [{ label, href? }]. El componente Breadcrumbs los pinta y el
//   JSON-LD BreadcrumbList lo emite buildSchema UNA sola vez (B3) — NO lo emite
//   el componente Breadcrumbs, para evitar el doble BreadcrumbList (anti-patrón
//   confirmado en BOMBERO y RENTADEILUMINACION).
// ============================================================================

import BaseLayout from "./BaseLayout.astro";
import TopBar from "@components/TopBar.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import WhatsAppFloat from "@components/WhatsAppFloat.astro";
import type { PageType, SchemaData } from "@lib/seo";

export interface Props {
  title?: string;
  /** Tripleta de keywords [kw1, kw2, kw3] (regla de metas). Ver KEYWORDS en site.ts. */
  keywords?: readonly string[];
  description?: string;
  canonical?: string;
  image?: string;
  pageType?: PageType;
  schemaData?: SchemaData;
  noindex?: boolean;
  /**
   * Migas de pan (para el componente visual). { label, href }.
   * Si se omite o queda vacío, no se renderiza la barra ni el BreadcrumbList.
   */
  breadcrumbs?: { label: string; href?: string }[];
  /**
   * Modo guía del chrome (TopBar/Header anotados + leyenda explicativa).
   * Default `true` → el sitio-plantilla muestra las guías en todas partes.
   * Las páginas de detalle de un módulo (p. ej. /modulos/topbar) pasan
   * `guia={false}`: ahí el módulo ya se documenta a fondo, así que el chrome
   * se muestra real (sin leyenda). El showcase de guías vive en el índice.
   */
  guia?: boolean;
  /**
   * Alias de conveniencia para activar TechArticle (opt-in).
   * `schemaType="TechArticle"` → equivalente a pasar pageType="techArticle"
   * y un schemaData.techArticle autoderivado (headline=title, fecha=hoy).
   * Si la página ya pasa pageType o schemaData.techArticle, ESOS ganan; el
   * alias solo rellena lo que falte. Patrón conservador para tipar las /modulos/*
   * sin importar helpers en cada página. NO afecta el grafo base.
   */
  schemaType?: 'TechArticle';
}

const { breadcrumbs = [], guia = false, schemaType, ...baseProps } = Astro.props;

// ── schemaType → auto-derive de techArticle (conservador, no toca pageType) ──
// El nodo TechArticle convive con cualquier pageType (se emite igual que FAQ
// como nodo adicional en buildSchema). Si la página ya pasó schemaData.techArticle
// con datos curados, NO los pisamos: el alias solo rellena cuando falta.
const wantsTechArticle = schemaType === "TechArticle";
const todayISO = new Date().toISOString().slice(0, 10);
const autoTechArticle = wantsTechArticle && !(baseProps.schemaData?.techArticle)
  ? {
      techArticle: {
        headline: baseProps.title ?? "",
        path: Astro.url.pathname,
        datePublished: todayISO,
        dateModified: todayISO,
      },
    }
  : {};

// Las migas alimentan el BreadcrumbList del schema (lo emite buildSchema UNA
// sola vez, B3 — el componente Breadcrumbs NO debe emitir su propio JSON-LD).
// El componente visual usa { label, href }; el schema usa { name, path }.
const schemaData: SchemaData = {
  ...(baseProps.schemaData ?? {}),
  ...autoTechArticle,
  ...(breadcrumbs.length > 0
    ? {
        breadcrumbs: [
          { name: "Inicio", path: "/" },
          ...breadcrumbs.map((b) => ({ name: b.label, path: b.href ?? "" })),
        ],
      }
    : {}),
};

// El modo guía es opt-in y no aparece en ninguna página de producción. Mantener
// sus reglas inline y condicionales evita cargar casi 4 KB de CSS en cada URL,
// sin quitar la presentación cuando una página activa `guia`.
const GUIDE_CSS = `.hbg,.bcg{background:var(--c-surface);border-bottom:1px solid var(--c-border)}.hbg-inner,.bcg-inner{max-width:var(--container-max);margin-inline:auto;padding:var(--sp-4) var(--container-px) var(--sp-5)}.hbg__tag,.bcg__tag{display:inline-flex;align-items:center;gap:var(--sp-1);margin:0 0 var(--sp-2);font-family:var(--font-heading);font-size:var(--text-xs);font-weight:var(--weight-bold);letter-spacing:.08em;text-transform:uppercase;color:var(--c-primary)}.hbg__intro,.bcg__intro{margin:0 0 var(--sp-4);font-size:var(--text-sm);line-height:var(--leading-normal);color:var(--c-ink-2);max-width:70ch}.hbg__intro code,.hbg__dato code,.hbg__edit code,.bcg__intro code,.bcg__dato code,.bcg__edit code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85em;background:var(--c-white);border:1px solid var(--c-border);border-radius:var(--radius-sm);padding:.05em .4em;color:var(--c-primary-dark)}.hbg__list,.bcg__list{list-style:none;margin:0;padding:0;display:grid;gap:var(--sp-3);grid-template-columns:1fr}.hbg__pt,.bcg__pt{display:flex;gap:var(--sp-3);align-items:start;background:var(--c-white);border:1px solid var(--c-border);border-radius:var(--radius-md);padding:var(--sp-3) var(--sp-4)}.hbg__num,.bcg__num{flex-shrink:0;display:inline-grid;place-items:center;width:24px;height:24px;border-radius:var(--radius-full);background:var(--c-primary);color:var(--c-white);font-family:var(--font-heading);font-weight:var(--weight-bold);font-size:var(--text-sm)}.hbg__pt-body,.bcg__pt-body{display:grid;gap:2px;min-width:0}.hbg__nombre,.bcg__nombre{margin:0;font-family:var(--font-heading);font-weight:var(--weight-semibold);color:var(--c-ink);font-size:var(--text-base)}.hbg__que,.bcg__que{margin:0;font-size:var(--text-sm);line-height:var(--leading-normal);color:var(--c-ink-2)}.hbg__dato,.bcg__dato{margin:4px 0 0;font-size:var(--text-xs);color:var(--c-muted);display:flex;align-items:center;gap:var(--sp-2);flex-wrap:wrap}.hbg__dato span,.hbg__edit span,.bcg__dato span,.bcg__edit span{text-transform:uppercase;letter-spacing:.06em;font-weight:var(--weight-semibold);color:var(--c-muted)}.hbg__edit,.bcg__edit{margin:var(--sp-4) 0 0;display:flex;align-items:center;gap:var(--sp-2);flex-wrap:wrap;font-size:var(--text-xs);color:var(--c-muted)}.bc-mark{flex-shrink:0;display:inline-grid;place-items:center;width:18px;height:18px;margin-right:6px;border-radius:var(--radius-full);background:var(--c-primary);color:var(--c-white);font-family:var(--font-heading);font-weight:var(--weight-bold);font-size:.6875rem}.hdr-mark{flex-shrink:0;display:inline-grid;place-items:center;width:18px;height:18px;border-radius:var(--radius-full);background:var(--c-primary);color:var(--c-white);font-family:var(--font-heading);font-weight:var(--weight-bold);font-size:.6875rem}.hdr-mark--cta{background:var(--c-white);color:var(--c-primary)}.breadcrumb__sepwrap .bc-mark{margin-right:0}@media (min-width:600px){.hbg__list,.bcg__list{grid-template-columns:repeat(2,1fr)}}@media (min-width:1000px){.hbg__list,.bcg__list{grid-template-columns:repeat(4,1fr)}}`;
---

<BaseLayout {...baseProps} schemaData={schemaData}>
  {guia && <style is:inline>{GUIDE_CSS}</style>}
  {/* TopBar: barra utilitaria. `guia` = modo plantilla-guía (anota cada punto). */}
  {/* En un sitio de cliente (o página de detalle), se pasa guia={false}. */}
  <TopBar guia={guia} />
  {/* Header: `guia` = leyenda explicativa bajo el header (igual que el topbar). */}
  <Header guia={guia} />

  {/* Barra de migas (entre header y contenido). Visual; el JSON-LD lo emite buildSchema.
      En modo guía se muestra SIEMPRE (ruta de ejemplo anotada + leyenda), aunque la
      página no pase `breadcrumbs`; en producción solo si hay ruta real. */}
  {(guia || breadcrumbs.length > 0) && <Breadcrumbs items={breadcrumbs} guia={guia} />}

  <main id="main-content">
    <slot />
  </main>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>
